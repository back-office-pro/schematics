          }
        }
      ]
    },
    {
      "name": "product",
      "descriptor": "reference",
      "virtuals": [
        {
          "name": "tax_inclusive_price",
          "function": "$price * (1 + $vat / 100)",
          "options": {
            "precision": 2,
            "unit": "€"
          }
        },
        {
          "name": "big_price",
          "function": "$price > 100 && $vat >= 10"
        },
        {
          "name": "reference",
          "function": "ref-$id-$sub_category.id"
