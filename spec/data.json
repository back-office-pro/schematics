      "attributes": [
        {
          "name": "designation",
          "type": "string",
          "options": {
            "unique": true,
            "required": true,
            "limit": 100
          }
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "price",
          "type": "currency",
          "options": {
            "precision": 2,
            "unit": "€"
          }
        },
        {
          "name": "vat",
          "type": "percentage",
          "options": {
            "precision": 1,
            "default": 19.6
          }
        },
        {
          "name": "in_stock",
          "type": "boolean",
          "options": {
            "default": false
          }
        },
        {
          "name": "logo",
          "type": "attachment",
          "options": {
            "required": true,
            "content_type": [
              "pdf"
            ],
            "size": 1
          }
        },
        {
          "name": "state",
          "type": "state_machine",
          "options": {
            "required": true,
            "default": "pending",
            "values": [
              "pending",
              "closed",
              "refused"
            ],
            "events": [
              {
                "name": "close",
                "icon": "times",
                "from": "pending",
                "to": "closed"
              },
              {
                "name": "refuse",
                "icon": "ban",
                "from": "pending",
                "to": "refused"
              },
              {
                "name": "reopen",
                "from": [
                  "closed",
                  "refused"
                ],
                "to": "pending"
              }
            ]
          }
        },
        {
          "name": "sub_category",
          "type": "belongs_to",
          "options": {
            "required": true
          }
        }
