{
    "stats": [
        {
            "entity": "user",
            "agregate": "count"
        },
        {
            "entity": "product",
            "agregate": "sum",
            "field": "price"
        },
        {
            "entity": "product",
            "agregate": "sum",
            "field": "tax_inclusive_price"
        }
    ],
    "charts": [
        {
            "type": "line",
            "entity": "category",
            "x": {
                "agregate": "group_by_day",
                "field": "created_at"
            },
            "y": {
                "agregate": "count"
            }
        },
        {
            "type": "pie",
            "entity": "user",
            "x": {
                "agregate": "group",
                "field": "locale"
            },
            "y": {
                "agregate": "count"
            }
        },
        {
            "type": "bar",
            "entity": "product",
            "x": {
                "agregate": "group",
                "field": "state"
            },
            "y": {
                "agregate": "sum",
                "field": "tax_inclusive_price"
            }
        }
    ],
    "entities": [
        {
            "type": "client",
            "icon": "user_tie",
            "descriptor": "full_name",
            "virtuals": [
                {
                    "name": "full_name",
                    "function": "$first_name $last_name"
                }
            ],
            "attributes": [
                {
                    "name": "first_name",
                    "type": "string",
                    "options": {
                        "required": true
                    }
                },
                {
                    "name": "last_name",
                    "type": "string",
                    "options": {
                        "required": true
                    }
                }
            ]
        },
        {
            "type": "sub_category",
            "icon": "box",
            "descriptor": "designation",
            "attributes": [
                {
                    "name": "designation",
                    "type": "string",
                    "options": {
                        "unique": true
                    }
                },
                {
                    "name": "category",
                    "type": "belongs_to",
                    "options": {
                        "required": true,
                        "inverse": {
                            "type": "has_many"
                        }
                    }
                }
            ]
        },
        {
            "type": "category",
            "icon": "box",
            "descriptor": "label",
            "attributes": [
                {
                    "name": "label",
                    "type": "string",
                    "options": {
                        "unique": true,
                        "required": true
                    }
                },
                {
                    "name": "preview",
                    "type": "attachment",
                    "options": {
                        "content_type": [
                            "png"
                        ]
                    }
                }
            ]
        },
        {
            "type": "product",
            "descriptor": "reference",
            "virtuals": [
                {
                    "name": "tax_inclusive_price",
                    "function": "$price * (1 + $vat / 100)",
                    "options": {
                        "scale": 2,
                        "unit": "€"
                    }
                },
                {
                    "name": "reference",
                    "function": "ref-$id-$sub_category.id"
                }
            ],
            "attributes": [
                {
                    "name": "designation",
                    "type": "string",
                    "options": {
                        "unique": true,
                        "limit": 100
                    }
                },
                {
                    "name": "description",
                    "type": "string"
                },
                {
                    "name": "price",
                    "type": "decimal",
                    "options": {
                        "precision": 5,
                        "scale": 2,
                        "unit": "€"
                    }
                },
                {
                    "name": "vat",
                    "type": "float",
                    "options": {
                        "default": 19.6,
                        "unit": "%"
                    }
                },
                {
                    "name": "in_stock",
                    "type": "boolean",
                    "options": {
                        "default": false
                    }
                },
                {
                    "name": "logo",
                    "type": "attachment",
                    "options": {
                        "required": true,
                        "content_type": [
                            "pdf"
                        ],
                        "size": 1
                    }
                },
                {
                    "name": "state",
                    "type": "enum",
                    "options": [
                        "available",
                        "not_available",
                        "available_soon"
                    ]
                },
                {
                    "name": "sub_category",
                    "type": "belongs_to",
                    "options": {
                        "required": true,
                        "inverse": {
                            "type": "has_many"
                        }
                    }
                }
            ]
        },
        {
            "type": "order",
            "attributes": [
                {
                    "name": "title",
                    "type": "string"
                },
                {
                    "name": "start_at",
                    "type": "datetime",
                    "options": {
                        "required": true,
                        "before": "ends_at"
                    }
                },
                {
                    "name": "ends_at",
                    "type": "datetime",
                    "options": {
                        "required": true,
                        "after": "start_at"
                    }
                },
                {
                    "name": "invoices",
                    "type": "attachments"
                },
                {
                    "name": "product",
                    "type": "belongs_to",
                    "options": {
                        "required": true,
                        "inverse": {
                            "type": "has_many"
                        }
                    }
                }
            ]
        }
    ]
}
