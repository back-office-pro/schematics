[Unit]
Description=<%= Tenant.human %> HTTP server
After=network.target

[Service]
User=root
WorkingDirectory=/home/deploy/<%= Tenant.subdomain %>
EnvironmentFile=/home/deploy/<%= Tenant.subdomain %>/.env
ExecStart=/home/deploy/<%= Tenant.subdomain %>/bin/rails server
Restart=always

[Install]
WantedBy=multi-user.target
