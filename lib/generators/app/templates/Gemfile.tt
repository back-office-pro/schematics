source "https://rubygems.org"

ruby Gem.ruby_version.to_s

<%- if env.development? -%>
group :development do
  gem "web-console"
  gem "error_highlight"
end
<%- end -%>
<%- if container? -%>
gem "schematics", path: "/app"
<%- elsif env.development? -%>
gem "schematics", path: "<%= root_path %>"
<%- else -%>
gem "schematics", ENV['CI'] && { github: "back-office-pro/schematics" }
<%- end -%>
