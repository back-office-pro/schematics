<%- if Server.ssl? -%>
upstream <%= upstream_name %> {
  server unix://<%= Rails.root.join('tmp', 'sockets', "#{name}.sock") %>;
}

server {
  server_name <%= name %>.<%= Server.domain %>;
  listen [::]:443 ssl;
  listen 443 ssl;

  root <%= Rails.root.join('public') %>;
  try_files $uri/index.html $uri @<%= upstream_name %>;

  access_log <%= Rails.root.join('log', name, 'nginx.access.log') %>;
  error_log <%= Rails.root.join('log', name, 'nginx.error.log') %> info;

  location @<%= upstream_name %> {
    proxy_pass http://<%= upstream_name %>;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;
  }

  ssl_certificate <%= Server.ssl_path.join('fullchain.pem') %>;
  ssl_certificate_key <%= Server.ssl_path.join('privkey.pem') %>;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
<%- else -%>
upstream <%= upstream_name %> {
  server unix://<%= Rails.root.join('tmp', 'sockets', "#{name}.sock") %>;
}

server {
  server_name <%= name %>.<%= Server.domain %>;
  listen 80;
  listen [::]:80;

  root <%= Rails.root.join('public') %>;
  try_files $uri/index.html $uri @<%= upstream_name %>;

  access_log <%= Rails.root.join('log', name, 'nginx.access.log') %>;
  error_log <%= Rails.root.join('log', name, 'nginx.error.log') %> info;

  location @<%= upstream_name %> {
    proxy_pass http://<%= upstream_name %>;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;
  }
}
<%- end -%>
