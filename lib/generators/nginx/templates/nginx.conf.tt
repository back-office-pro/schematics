<%- if Tenant.ssl? -%>
upstream <%= Tenant.app_name %> {
  server unix://<%= Rails.root.join('tmp', 'sockets', 'puma.sock') %>;
}

server {
  server_name <%= Tenant.host %>;
  listen [::]:443 ssl;
  listen 443 ssl;

  root <%= Rails.root.join('public') %>;
  try_files $uri/index.html $uri @<%= Tenant.app_name %>;

  access_log <%= Rails.root.join('log', 'nginx.access.log') %>;
  error_log <%= Rails.root.join('log', 'nginx.error.log') %> info;

  location @<%= Tenant.app_name %> {
    proxy_pass http://<%= Tenant.app_name %>;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;
  }

  ssl_certificate <%= Tenant.ssl_path.join('fullchain.pem') %>;
  ssl_certificate_key <%= Tenant.ssl_path.join('privkey.pem') %>;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
<%- else -%>
upstream <%= Tenant.app_name %> {
  server unix://<%= Rails.root.join('tmp', 'sockets', 'puma.sock') %>;
}

server {
  server_name <%= Tenant.host %>;
  listen 80;
  listen [::]:80;

  root <%= Rails.root.join('public') %>;
  try_files $uri/index.html $uri @<%= Tenant.app_name %>;

  access_log <%= Rails.root.join('log', 'nginx.access.log') %>;
  error_log <%= Rails.root.join('log', 'nginx.error.log') %> info;

  location @<%= Tenant.app_name %> {
    proxy_pass http://<%= Tenant.app_name %>;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;
  }
}
<%- end -%>
