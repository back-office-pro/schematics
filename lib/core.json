  {
    "name": "session",
    "options": {
      "icon": "user_shield",
      "hidden": true,
      "actions": [
        "index",
        "show",
        "create",
        "destroy"
      ]
    },
    "attributes": [
      {
        "name": "auth_token",
        "type": "token"
      },
      {
        "name": "user_agent",
        "type": "user_agent",
        "options": {
          "readonly": true
        }
      },
      {
        "name": "ip",
        "type": "ip",
        "options": {
          "readonly": true
        }
      },
      {
        "name": "user",
