      },
      {
        "name": "state",
        "type": "state_machine",
        "options": {
          "required": true,
          "direct_assignment": true,
          "default": "pending",
          "values": [
            "pending",
            "in_progress",
            "migrated",
            "error"
          ],
          "events": [
            {
              "name": "migrate",
              "icon": "arrow_trend_up",
              "from": [
                "pending",
                "error"
              ],
              "to": "in_progress"
            }
          ]
        }
      }
