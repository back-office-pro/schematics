            "count",
            "sum",
            "maximum",
            "minimum",
            "average"
          ]
        }
      },
      {
        "name": "model",
        "type": "model",
        "options": {
          "required": true
        }
      },
      {
        "name": "field",
        "type": "model_field",
        "options": {
          "depends_on": "model",
