  {
    "name": "task",
    "options": {
      "icon": "list_check",
      "descriptor": "title"
    },
    "associations": [
      {
        "type": "has_and_belongs_to_many",
        "name": "users"
      }
    ],
    "attributes": [
      {
        "name": "title",
        "type": "string",
        "options": {
          "required": true,
          "encrypted": true,
          "limit": 100
        }
      },
      {
        "name": "content",
        "type": "rich_text"
      },
      {
        "name": "applicant",
        "type": "references",
        "options": {
          "required": true,
          "inverse": {
            "name": "requested_tasks"
          }
        }
      },
      {
        "name": "deadline",
        "type": "datetime"
      },
      {
        "name": "state",
        "type": "state_machine",
        "options": {
          "required": true,
          "default": "pending",
          "values": [
            "pending",
            "in_progress",
            "completed",
            "aborted"
          ],
          "events": [
            {
              "name": "start",
              "icon": "hammer",
              "from": "pending",
              "to": "in_progress"
            },
            {
              "name": "complete",
              "icon": "check",
              "from": "in_progress",
              "to": "completed"
            },
            {
              "name": "abort",
              "icon": "ban",
              "from": [
                "pending",
                "in_progress"
              ],
              "to": "aborted"
            }
          ]
        }
      }
    ],
    "virtuals": [
      {
        "name": "late",
        "function": "NOW() > $deadline"
      }
    ]
  },
