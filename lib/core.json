  },
  {
    "name": "schema_dataset",
    "options": {
      "icon": "project_diagram",
      "actions": [
        "index",
        "create",
        "destroy"
      ]
    },
    "attributes": [
      {
        "name": "data",
        "type": "jsonb"
      },
      {
        "name": "state",
        "type": "state_machine",
        "options": {
          "required": true,
          "default": "scheduled",
          "values": [
            "scheduled",
            "migrated"
          ],
          "events": [
            {
              "name": "migrate",
              "icon": "arrow_trend_up",
              "from": "scheduled",
              "to": "migrated"
            }
          ]
        }
      }
    ],
    "virtuals": [
      {
        "name": "version",
        "function": "$lock_version + 1",
        "options": {
          "precision": 0
        }
      }
    ]
  }
