{
  "entities": [
    {
      "name": "user",
      "icon": "users",
      "descriptor": "full_name",
      "virtuals": [
        {
          "name": "full_name",
          "function": "$last_name $first_name"
        }
      ],
      "attributes": [
        {
          "name": "email",
          "type": "email",
          "options": {
            "unique": true,
            "required": true
          }
        },
        {
          "name": "password",
          "type": "digest",
          "options": {
            "confirm": true,
            "min": 8
          }
        },
        {
          "name": "auth_token",
          "type": "token"
        },
        {
          "name": "password_reset_token",
          "type": "token"
        },
        {
          "name": "first_name",
          "type": "string",
          "options": {
            "required": true
          }
        },
        {
          "name": "last_name",
          "type": "string",
          "options": {
            "required": true
          }
        },
        {
          "name": "avatar",
          "type": "attachment",
          "options": {
            "content_type": [
              "png",
              "jpeg",
              "jpg"
            ],
            "size": 2
          }
        },
        {
          "name": "locale",
          "type": "enum",
          "options": {
            "required": true,
            "default": "fr",
            "values": [
              "fr",
              "en"
            ]
          }
        },
        {
          "name": "time_zone",
          "type": "time_zone",
          "options": {
            "required": true
          }
        },
        {
          "name": "preferences",
          "type": "jsonb",
          "options": {
            "hidden": true,
            "default": {}
          }
        },
        {
          "name": "role",
          "type": "belongs_to",
          "options": {
            "required": true
          }
        },
        {
          "name": "last_seen_at",
          "type": "timestamp"
        },
        {
          "name": "read_notifications_at",
          "type": "timestamp"
        },
        {
          "name": "reset_password_sent_at",
          "type": "timestamp"
        }
      ]
    },
    {
      "name": "message",
      "icon": "inbox",
      "descriptor": "subject",
      "attributes": [
        {
          "name": "subject",
          "type": "string",
          "options": {
            "required": true
          }
        },
        {
          "name": "content",
          "type": "rich_text",
          "options": {
            "required": true
          }
        },
        {
          "name": "author",
          "type": "references",
          "options": {
            "required": true,
            "inverse": {
              "name": "sent_messages"
            }
          }
        },
        {
          "name": "recipient",
          "type": "belongs_to",
          "options": {
            "required": true,
            "type": "user",
            "inverse": {
              "name": "received_messages"
            }
          }
        }
      ]
    },
    {
      "name": "active_storage/attachment",
      "icon": "file",
      "descriptor": "filename",
      "actions": [
        "index",
        "show",
        "destroy"
      ],
      "attributes": [
        {
          "name": "filename",
          "type": "string"
        },
        {
          "name": "content_type",
          "type": "mime"
        },
        {
          "name": "byte_size",
          "type": "byte"
        },
        {
          "name": "blob",
          "type": "blob"
        },
        {
          "name": "record",
          "type": "belongs_to",
          "options": {
            "polymorphic": true
          }
        }
      ]
    },
    {
      "name": "setting",
      "type": "singleton",
      "icon": "cog",
      "descriptor": "company_name",
      "attributes": [
        {
          "name": "company_name",
          "type": "string",
          "options": {
            "cached": true
          }
        },
        {
          "name": "company_address",
          "type": "address"
        },
        {
          "name": "company_registration_number",
          "type": "string"
        },
        {
          "name": "company_logo",
          "type": "attachment",
          "options": {
            "cached": true,
            "content_type": [
              "png",
              "jpeg",
              "jpg"
            ],
            "size": 2
          }
        },
        {
          "name": "theme_color",
          "type": "color",
          "options": {
            "cached": true
          }
        }
      ]
    },
    {
      "name": "role",
      "icon": "user_lock",
      "descriptor": "name",
      "associations": [
        {
          "type": "has_and_belongs_to_many",
          "name": "permission"
        },
        {
          "type": "has_and_belongs_to_many",
          "name": "chart"
        },
        {
          "type": "has_and_belongs_to_many",
          "name": "stat"
        }
      ],
      "attributes": [
        {
          "name": "name",
          "type": "citext",
          "options": {
            "unique": true,
            "required": true
          }
        }
      ]
    },
    {
      "name": "permission",
      "icon": "key",
      "descriptor": "name",
      "actions": [
        "index",
        "show"
      ],
      "attributes": [
        {
          "name": "model",
          "type": "model",
          "options": {
            "required": true,
            "readonly": true
          }
        },
        {
          "name": "action",
          "type": "action",
          "options": {
            "required": true,
            "readonly": true
          }
        }
      ],
      "virtuals": [
        {
          "name": "name",
          "function": "$action $model"
        }
      ]
    },
    {
      "name": "import",
      "icon": "cloud_upload_alt",
      "actions": [
        "index",
        "show"
      ],
      "attributes": [
        {
          "name": "file",
          "type": "attachment",
          "options": {
            "required": true,
            "content_type": [
              "csv"
            ]
          }
        },
        {
          "name": "status",
          "type": "enum",
          "options": {
            "required": true,
            "readonly": true,
            "default": "pending",
            "values": [
              "pending",
              "finished",
              "error"
            ]
          }
        },
        {
          "name": "progress",
          "type": "percentage",
          "options": {
            "readonly": true,
            "precision": 1,
            "default": 0.0
          }
        },
        {
          "name": "import_errors",
          "type": "jsonb"
        },
        {
          "name": "author",
          "type": "references",
          "options": {
            "required": true
          }
        }
      ]
    },
    {
      "name": "licence",
      "type": "singleton",
      "descriptor": "plan",
      "icon": "id_badge",
      "actions": [
        "show"
      ],
      "attributes": [
        {
          "name": "plan",
          "type": "enum",
          "options": {
            "required": true,
            "readonly": true,
            "default": "pro",
            "values": [
              "pro",
              "business",
              "enterprise"
            ]
          }
        },
        {
          "name": "expires_on",
          "type": "date"
        }
      ]
    },
    {
      "name": "chart",
      "icon": "chart_line",
      "attributes": [
        {
          "name": "kind",
          "type": "enum",
          "options": {
            "required": true,
            "values": [
              "line",
              "pie",
              "bar",
              "area",
              "scatter",
              "column",
              "geo"
            ]
          }
        },
        {
          "name": "model",
          "type": "model",
          "options": {
            "required": true
          }
        },
        {
          "name": "x_field",
          "type": "model_field",
          "options": {
            "required": true,
            "depends_on": "model"
          }
        },
        {
          "name": "x_agregate",
          "type": "enum",
          "options": {
            "required": true,
            "values": [
              "group",
              "group_by_day",
              "group_by_week",
              "group_by_month"
            ]
          }
        },
        {
          "name": "y_field",
          "type": "model_field",
          "options": {
            "depends_on": "model"
          }
        },
        {
          "name": "y_agregate",
          "type": "enum",
          "options": {
            "required": true,
            "values": [
              "count",
              "sum",
              "maximum",
              "minimum",
              "average"
            ]
          }
        }
      ]
    },
    {
      "name": "stat",
      "icon": "stopwatch_20",
      "attributes": [
        {
          "name": "model",
          "type": "model",
          "options": {
            "required": true
          }
        },
        {
          "name": "agregate",
          "type": "enum",
          "options": {
            "required": true,
            "values": [
              "count",
              "sum",
              "maximum",
              "minimum",
              "average"
            ]
          }
        },
        {
          "name": "field",
          "type": "model_field",
          "options": {
            "depends_on": "model"
          }
        }
      ]
    },
    {
      "name": "comparison",
      "icon": "not_equal",
      "actions": [
        "show"
      ],
      "attributes": [
        {
          "name": "model",
          "type": "model",
          "options": {
            "required": true
          }
        },
        {
          "name": "ids",
          "type": "array",
          "options": {
            "required": true
          }
        }
      ]
    }
  ]
}
