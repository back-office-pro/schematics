{
  "entities": [
    {
      "name": "user",
      "icon": "users",
      "descriptor": "full_name",
      "virtuals": [
        {
          "name": "full_name",
          "function": "$last_name $first_name"
        }
      ],
      "attributes": [
        {
          "name": "email",
          "type": "email",
          "options": {
            "unique": true
          }
        },
        {
          "name": "password",
          "type": "digest",
          "options": {
            "min": 8
          }
        },
        {
          "name": "auth_token",
          "type": "token"
        },
        {
          "name": "password_reset_token",
          "type": "token"
        },
        {
          "name": "first_name",
          "type": "string",
          "options": {
            "required": true
          }
        },
        {
          "name": "last_name",
          "type": "string",
          "options": {
            "required": true
          }
        },
        {
          "name": "avatar",
          "type": "attachment",
          "options": {
            "content_type": [
              "png",
              "jpeg",
              "jpg"
            ],
            "size": 2
          }
        },
        {
          "name": "locale",
          "type": "enum",
          "options": {
            "required": true,
            "default": "fr",
            "values": [
              "fr",
              "en"
            ]
          }
        },
        {
          "name": "time_zone",
          "type": "time_zone",
          "options": {
            "required": true,
            "default": "Paris"
          }
        },
        {
          "name": "preferences",
          "type": "jsonb",
          "options": {
            "hidden": true,
            "default": {
              "theme": "light",
              "sidebar_toggled": false
            }
          }
        },
        {
          "name": "role",
          "type": "belongs_to",
          "options": {
            "required": true
          }
        }
      ]
    },
    {
      "name": "message",
      "icon": "inbox",
      "descriptor": "subject",
      "attributes": [
        {
          "name": "subject",
          "type": "string",
          "options": {
            "required": true
          }
        },
        {
          "name": "content",
          "type": "rich_text",
          "options": {
            "required": true
          }
        },
        {
          "name": "author",
          "type": "references",
          "options": {
            "required": true,
            "inverse": {
              "name": "sent_messages"
            }
          }
        },
        {
          "name": "recipient",
          "type": "belongs_to",
          "options": {
            "required": true,
            "type": "user",
            "inverse": {
              "name": "received_messages"
            }
          }
        }
      ]
    },
    {
      "name": "active_storage/attachment",
      "icon": "file",
      "descriptor": "filename",
      "actions": [
        "index",
        "show",
        "destroy"
      ],
      "attributes": [
        {
          "name": "filename",
          "type": "string"
        },
        {
          "name": "content_type",
          "type": "mime"
        },
        {
          "name": "byte_size",
          "type": "byte"
        },
        {
          "name": "blob",
          "type": "blob"
        },
        {
          "name": "record",
          "type": "belongs_to",
          "options": {
            "polymorphic": true
          }
        }
      ]
    },
    {
      "name": "setting",
      "type": "singleton",
      "icon": "cog",
      "descriptor": "company_name",
      "attributes": [
        {
          "name": "company_name",
          "type": "string",
          "options": {
            "required": true,
            "cached": true
          }
        },
        {
          "name": "company_address",
          "type": "address"
        },
        {
          "name": "company_registration_number",
          "type": "string"
        },
        {
          "name": "company_logo",
          "type": "attachment",
          "options": {
            "cached": true,
            "content_type": [
              "png",
              "jpeg",
              "jpg"
            ],
            "size": 2
          }
        },
        {
          "name": "theme_color",
          "type": "color",
          "options": {
            "required": true,
            "cached": true
          }
        }
      ]
    },
    {
      "name": "role",
      "icon": "user_lock",
      "descriptor": "name",
      "associations": [
        {
          "type": "has_and_belongs_to_many",
          "name": "permission"
        }
      ],
      "attributes": [
        {
          "name": "name",
          "type": "string",
          "options": {
            "unique": true
          }
        }
      ]
    },
    {
      "name": "permission",
      "icon": "key",
      "descriptor": "name",
      "actions": [
        "index",
        "show"
      ],
      "attributes": [
        {
          "name": "model",
          "type": "model",
          "options": {
            "required": true,
            "readonly": true
          }
        },
        {
          "name": "action",
          "type": "enum",
          "options": {
            "required": true,
            "readonly": true,
            "values": [
              "index",
              "show",
              "create",
              "update",
              "import",
              "destroy",
              "archive"
            ]
          }
        }
      ],
      "virtuals": [
        {
          "name": "name",
          "function": "$action $model"
        }
      ]
    },
    {
      "name": "import",
      "icon": "cloud_upload_alt",
      "actions": [
        "index",
        "show"
      ],
      "attributes": [
        {
          "name": "file",
          "type": "attachment",
          "options": {
            "required": true,
            "content_type": [
              "csv"
            ]
          }
        },
        {
          "name": "status",
          "type": "enum",
          "options": {
            "required": true,
            "readonly": true,
            "default": "pending",
            "values": [
              "pending",
              "finished",
              "error"
            ]
          }
        },
        {
          "name": "progress",
          "type": "percentage",
          "options": {
            "readonly": true,
            "precision": 1,
            "default": 0.0
          }
        },
        {
          "name": "import_errors",
          "type": "jsonb"
        },
        {
          "name": "author",
          "type": "references",
          "options": {
            "required": true
          }
        }
      ]
    },
    {
      "name": "licence",
      "type": "singleton",
      "descriptor": "plan",
      "icon": "id_badge",
      "actions": [
        "show"
      ],
      "attributes": [
        {
          "name": "plan",
          "type": "enum",
          "options": {
            "required": true,
            "readonly": true,
            "default": "free",
            "values": [
              "free",
              "pro",
              "enterprise"
            ]
          }
        },
        {
          "name": "expires_at",
          "type": "timestamp"
        }
      ]
    }
  ]
}
