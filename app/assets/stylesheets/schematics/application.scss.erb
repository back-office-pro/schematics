$input-btn-focus-width: 0;
$grid-gutter-width: 1.5rem !default;
@import "bootswatch/<%= "flatly" %>/variables";
$link-color: $primary;
$pagination-bg: $primary;
$pagination-hover-bg: darken($primary, 15%);
$pagination-disabled-bg: lighten($primary, 15%);
$pagination-active-bg: $primary;
$navbar-dark-hover-color: $primary;
@import "bootstrap";
@import "bootswatch/<%= "flatly" %>/bootswatch";
@import "font_awesome5_webfont";
@import "typeahead";
@import "trix/dist/trix";
@import "actiontext";

/**
 * Layout
 */
 
html, body {
  height: 100%;
  font-size: 0.9rem;
}

.sidebar-sticky {
  position: sticky;
  top: 0;
  overflow-x: hidden;
  overflow-y: auto;
}

.navbar {
  z-index: 2;
  height: 4rem;
  .navbar-nav {
    height: 4rem;
  }
  .navbar-search {
    width: 25rem;
  }
  .badge.badge-danger {
    position: absolute;
    top: -0.25rem;
    right: 0.75rem;
    border-radius: 1rem;
    padding: 0.25rem 0.4rem;
  }
}

nav.sticky-top[aria-label="breadcrumb"] {
  top: 4rem;
  z-index: 1;
  .nav-item:not(.breadcrumb-item) a {
    text-decoration: underline;
  }
}

.sidebar {
  z-index: 3;
  flex: 0 0 14rem;
  max-width: 14rem;
  box-shadow: 0 2px 2px 0 rgba(60 , 75, 100, 0.14), 0 3px 1px -2px rgba(60, 75, 100, 0.12), 0 1px 5px 0 rgba(60, 75, 100, 0.2);
  .sidebar-brand {
    height: 4rem;
    line-height: 4rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: .05rem;
    font-weight: 800;
    text-decoration: none !important;
    background: rgba(0, 0, 0, 0.3);
  }
  .nav-link.active {
    color: white !important;
    .list-group-item {
      border: 1px solid $white !important;
      .badge {
        background: $white !important;
      }
    }
  }
  .nav-item.d-none {
    background: rgba(0, 0, 0, 0.15);
  }
}

.content {
  flex: 0 0 calc(100% - 14rem);
  max-width: calc(100% - 14rem);
}

@include media-breakpoint-down(sm) {
  .sidebar {
    flex: 0 0 6rem;
    max-width: 6rem;
  }
  .content {
    flex: 0 0 calc(100% - 6rem);
    max-width: calc(100% - 6rem);
  }
}

/**
 * Tables
 */ 

.table-bordered th, .table-bordered td {
  border-left-style: dotted !important;
  border-right-style: dotted !important;
}

.table thead tr:first-child th a {
  text-decoration: underline;
}

.table tr[onclick] {
  cursor: pointer;
}

.table td:first-child {
  position: sticky;
  left: 0px;
  width: 1%;
}

.table thead th {
  border-top-width: 0px !important;
  border-bottom-width: 0px !important;
}

.table tbody tr td:first-child, .table tbody tr td:nth-child(2), .table tbody tr th:first-child {
  border-left-width: 0px !important;
}

.table tbody tr:not([onclick]):first-child td, .table tbody tr:not([onclick]):first-child th {
  border-top-width: 0px !important;
}

.table tbody tr:last-child td, .table tbody tr:last-child th {
  border-bottom-width: 0px !important;
}

.table tbody tr td:last-child, .table tbody tr td:first-child, .table tbody tr th:last-child {
  border-right-width: 0px !important;
}

.table tr.disabled {
  pointer-events: none;
}

.table tr td .btn-group.enabled {
  pointer-events: auto;
}

.table tr.filters th:last-child > div {
  margin-right: 0.5rem !important;
}

.pagy-bootstrap-nav .pagination {
  justify-content: center;
}

/**
 * Cards
 */

.modal {
  .card {
    box-shadow: none !important;
    margin-top: 1rem !important;
  }
}

.card h5 {
  font-size: 1rem;
  line-height: 2.1rem;
}

.card .card-header[data-toggle="collapse"] {
  text-decoration: none;
}

.card .card-header[data-toggle="collapse"]::after {
  position: absolute;
  right: 0;
  top: 0;
  padding-right: 1.5rem;
  line-height: 45px;
  font-size: 1.25rem;
  font-weight: 900;
  content: '\f107';
  font-family: 'Font Awesome 5 Free';
  color: #d1d3e2;
}

.card .card-header[data-toggle="collapse"].collapsed::after {
  content: '\f105';
}

/**
 * Dropdowns
 */
 
.dropdown.no-arrow .dropdown-toggle::after {
  display: none;
}

@keyframes growIn {
  0% {
    transform: scale(.9);
    opacity: 0
  }

  100% {
    transform: scale(1);
    opacity: 1
  }
}

.animated--grow-in {
  animation-name: growIn;
  animation-duration: .2s;
  animation-timing-function: transform cubic-bezier(0.18, 1.25, 0.4, 1), opacity cubic-bezier(0, 1, 0.4, 1);
}

/**
 * Buttons
 */

.w-0 {
  width: 0px;
}

.btn-icon-split {
  padding: 0;
  overflow: hidden;
  display: inline-flex;
  align-items: stretch;
  justify-content: center;
}

.btn-icon-split .icon {
  background: rgba(0, 0 , 0, 0.15);
  display: inline-block;
  padding: .375rem .75rem;
}

.btn-icon-split .text {
  display: inline-block;
  padding: .375rem .75rem;
}

/**
 * Forms
 */

.form-control {
  font-size: 0.9rem;
}

label.custom-file-label {
  background: $light;
  border: 0;
}

label.custom-file-label::after {
  background: $primary;
  color: white;
  content: "<%= I18n.t('schematics.application.form.attachment.browse') %>";
}

input.custom-file-input.is-valid + label.custom-file-label::after {
  background: $success;
}

input.custom-file-input.is-invalid + label.custom-file-label::after {
  background: $danger;
}

/**
 * Toasts
 */

.toast {
  position: fixed; 
  z-index: 4; 
  right: 1rem; 
  top: 1rem;
}
