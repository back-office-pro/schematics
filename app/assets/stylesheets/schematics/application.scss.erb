@import "bootswatch/<%= "flatly" %>/variables";
$enable-gradients: true;
$enable-shadows: true;
$input-btn-focus-box-shadow: none;
@import "bootstrap";
@import "bootswatch/<%= "flatly" %>/bootswatch";
@import "font_awesome5_webfont";
@import "typeahead";

/**
 * Layout
 */
 
html, body {
  height: 100%;
}

.sidebar-sticky {
  position: sticky;
  top: 0;
  overflow-x: hidden;
  overflow-y: auto;
}

.navbar {
  z-index: 2;
  height: 4rem;
  .navbar-nav {
    height: 4rem;
  }
  .navbar-search {
    width: 25rem;
  }
  .badge.badge-danger {
    position: absolute;
    top: -0.25rem;
    right: 0.75rem;
    border-radius: 1rem;
  }
}

nav.sticky-top[aria-label="breadcrumb"] {
  top: 4rem;
  z-index: 1;
}

.sidebar {
  z-index: 1;
  flex: 0 0 12rem;
  max-width: 12rem;
  box-shadow: 0rem 0rem 1rem rgba(0, 0, 0, 0.3);
  .sidebar-brand {
    height: 4rem;
    line-height: 4rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: .05rem;
    font-weight: 800;
    text-decoration: none !important;
  }
  .nav-link.active {
    color: white !important;
  }
  i.fas {
    text-shadow: -7px 8px 2px rgba(0,0,0,0.15), -3px 5px rgba(0,0,0,0.15);
  }
}

.content {
  flex: 0 0 calc(100% - 12rem);
  max-width: calc(100% - 12rem);
}

@include media-breakpoint-down(sm) {
  .sidebar {
    flex: 0 0 6rem;
    max-width: 6rem;
    .sidebar-brand {
      position: absolute;
      left: -0.75rem;
      top: 1rem;
      transform-origin: bottom;
      transform: rotate(-90deg);
    }
  }
  .content {
    flex: 0 0 calc(100% - 6rem);
    max-width: calc(100% - 6rem);
  }
}

/**
 * Tables
 */ 

.table tr[onclick] {
  cursor: pointer;
}

.table.with-actions {
  thead tr:first-child th {
    padding: 0;
  }
  td:first-child {
    position: sticky;
    left: 0px;
    width: 1%;
  }
}

.table thead th {
  border-top-width: 0px !important;
  border-bottom-width: 0px !important;
}

.pagy-bootstrap-nav.pagination {
  justify-content: center;
  font-size: 1rem;
}

/**
 * Cards
 */
 
.card-header-title {
  line-height: 36px;
}

.card .card-header[data-toggle="collapse"] {
  text-decoration: none;
}

.card .card-header[data-toggle="collapse"]::after {
  position: absolute;
  right: 0;
  top: 0;
  padding-right: 1.725rem;
  line-height: 51px;
  font-weight: 900;
  content: '\f107';
  font-family: 'Font Awesome 5 Free';
  color: #d1d3e2;
}

.card .card-header[data-toggle="collapse"].collapsed::after {
  content: '\f105';
}

/**
 * Dropdowns
 */
 
.dropdown.no-arrow .dropdown-toggle::after {
  display: none;
}

@keyframes growIn {
  0% {
    transform: scale(.9);
    opacity: 0
  }

  100% {
    transform: scale(1);
    opacity: 1
  }
}

.animated--grow-in {
  animation-name: growIn;
  animation-duration: .2s;
  animation-timing-function: transform cubic-bezier(0.18, 1.25, 0.4, 1), opacity cubic-bezier(0, 1, 0.4, 1);
}

/**
 * Buttons
 */

.w-0 {
  width: 0px;
}

.btn-icon-split {
  padding: 0;
  overflow: hidden;
  display: inline-flex;
  align-items: stretch;
  justify-content: center;
}

.btn-icon-split .icon {
  background: rgba(0, 0 , 0, 0.15);
  display: inline-block;
  padding: .375rem .75rem;
}

.btn-icon-split .text {
  display: inline-block;
  padding: .375rem .75rem;
}

/**
 * Forms
 */

label.custom-file-label {
  background: $light;
  border: 0;
}

label.custom-file-label::after {
  @include gradient-bg($primary);
  color: white;
  content: "<%= I18n.t('.forms.attachment.browse') %>";
}

input.custom-file-input.is-valid + label.custom-file-label::after {
  @include gradient-bg($success);
}

input.custom-file-input.is-invalid + label.custom-file-label::after {
  @include gradient-bg($danger);
}

/**
 * Toasts
 */

.toast {
  position: fixed; 
  z-index: 3; 
  right: 1rem; 
  top: 1rem;
}
