{
  "name": "<%= Configuration.company_name %>",
  "short_name": "<%= Configuration.company_name %>",
  "background_color": "<%= Configuration.theme_color %>",
  "theme_color": "<%= Configuration.theme_color %>",
  "display": "standalone",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "icons": [
    <% if Configuration.with_attached_company_logo.company_logo.attached? %>
      {
        "src": "<%= rails_blob_path(Configuration.with_attached_company_logo.company_logo) %>",
        "sizes": "any",
        "type": "<%= Configuration.with_attached_company_logo.company_logo.content_type %>"
      }
    <% else %>
      {
        "src": "<%= asset_path('logo.svg') %>",
        "sizes": "any",
        "type": "image/svg+xml"
      }
    <% end %>
  ]
}
