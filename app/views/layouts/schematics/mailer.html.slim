doctype html
html
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width,initial-scale=1'
    = stylesheet_link_tag 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css', media: 'all'
  body
    .min-vh-100.bg-primary
      .container.my-4
        .text-center.text-white.my-4
          = render Schematics::Attachment::Component.company_logo(icon: :building)
        .card.shadow-sm.my-4
          .card-body.p-3
            = yield
