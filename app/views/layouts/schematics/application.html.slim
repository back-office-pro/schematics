doctype html
html lang=I18n.locale dir='ltr'
  head
    meta charset='utf-8'
    meta name='turbo-cache-control' content='no-preview'
    meta name='viewport' content='width=device-width,initial-scale=1'
    meta name='theme-color' content=config(:theme_color)
    title #{config(:company_name)} - #{title}
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload'
    = render Schematics::ThemeStylesheetLink::Component.new(theme: 'light')
    = render Schematics::ThemeStylesheetLink::Component.new(theme: 'dark')
    = render Schematics::Favicon::Component.new
    = stylesheet_link_tag 'schematics/application', media: 'all', 'data-turbo-track': 'reload'
    = javascript_importmap_tags
    = javascript_import_module_tag 'schematics/application'
    = javascript_include_tag 'https://www.gstatic.com/charts/loader.js'
    = javascript_include_tag "https://maps.googleapis.com/maps/api/js?key=#{Schematics::Engine.credentials.gcloud[:api_key]}&libraries=places"
    = render Schematics::ThemeCustomStylesheet::Component.new
    = render Schematics::InlineJavascript::Component.new
  body data-controller='application'
    = turbo_stream_from current_user
    = render Schematics::Toast::Component.with_collection(flash.to_a)
    = render Schematics::SearchBarModal::Component.new
    .container-fluid.p-0.h-100
      .row.g-0.h-100
        = render Schematics::Sidebar::Component.new
        .col.content class=('toggled' if preferences(:sidebar_toggled, false))
          = render Schematics::Navbar::Component.new
          .container-fluid.overflow-hidden.my-3.px-3
            = yield
          = render Schematics::Footer::Component.new
    = yield :charts_js
