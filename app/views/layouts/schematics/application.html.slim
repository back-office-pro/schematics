doctype html
html
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width,initial-scale=1'
    title #{settings(:company_name)} - #{title}
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload'
    = stylesheet_link_tag 'schematics/themes/light/theme',
                          media: 'all',
                          'data-turbolinks-track': 'reload',
                          id: 'light',
                          disabled: preferences(:theme) != 'light'
    = stylesheet_link_tag 'schematics/themes/dark/theme',
                          media: 'all',
                          'data-turbolinks-track': 'reload',
                          id: 'dark',
                          disabled: preferences(:theme) != 'dark'
    = stylesheet_link_tag 'schematics/application', media: 'all', 'data-turbolinks-track': 'reload'
    = javascript_pack_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'https://www.gstatic.com/charts/loader.js'
    = javascript_include_tag "https://maps.googleapis.com/maps/api/js?key=#{Schematics::Engine.credentials.gcloud[:api_key]}&libraries=places"
    = javascript_include_tag 'schematics/application', 'data-turbolinks-track': 'reload'
    = timeago_script_tag
    javascript:
      window.I18n = #{i18n_javascript}
  body
    - flash.each do |f|
      = render Schematics::Toast::Component.new(flash: f)
    .container-fluid.p-0.h-100
      .row.no-gutters.h-100
        .col.bg-primary.sidebar class=('toggled' if preferences(:sidebar_toggled))
          = render Schematics::Sidebar::Component.new
        .col.bg-light.content class=('toggled' if preferences(:sidebar_toggled))
          nav.navbar.navbar-light.navbar-expand.p-0.sticky-top
            = render Schematics::BreadcrumbTrail::Component.new
            ul.navbar-nav.ml-auto.p-3
              = render Schematics::Navbar::Component.new
          .container-fluid.my-3.px-3.animate__animated class=('animate__slideInDown' if params[:page].blank?)
            = yield
          = render Schematics::Footer::Component.new
