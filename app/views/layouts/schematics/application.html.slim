doctype html
html lang=::I18n.locale dir='ltr'
  head
    meta charset='utf-8'
    meta name='turbolinks-cache-control' content='no-preview'
    meta name='viewport' content='width=device-width,initial-scale=1'
    meta name='theme-color' content=settings(:theme_color)
    title #{settings(:company_name)} - #{title}
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload'
    = render Schematics::ThemeStylesheetLink::Component.new(theme: 'light')
    = render Schematics::ThemeStylesheetLink::Component.new(theme: 'dark')
    = render Schematics::Favicon::Component.new
    = stylesheet_link_tag 'schematics/application', media: 'all', 'data-turbolinks-track': 'reload'
    = javascript_pack_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'https://www.gstatic.com/charts/loader.js'
    = javascript_include_tag "https://maps.googleapis.com/maps/api/js?key=#{Schematics::Engine.credentials.gcloud[:api_key]}&libraries=places"
    = javascript_include_tag 'schematics/controllers', type: 'module', crossorigin: 'anonymous', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'schematics/application', 'data-turbolinks-track': 'reload'
    css [nonce=content_security_policy_nonce]:
      :root {
        --bs-primary: #{settings(:theme_color)};
        --bs-primary-darken: #{theme_color_darken};
        --bs-primary-rgb: #{theme_color_rgb};
      }
    javascript [nonce=content_security_policy_nonce]:
      window.I18n = #{i18n_javascript}
  body
    = render Schematics::Toast::Component.with_collection(flash.to_a)
    .container-fluid.p-0.h-100
      .row.g-0.h-100
        = render Schematics::Sidebar::Component.new
        .col.content class=('toggled' if preferences(:sidebar_toggled, false))
          = render Schematics::Navbar::Component.new
          .container-fluid.overflow-hidden.my-3.px-3.animate__animated class=('animate__slideInDown' if params[:page].blank?)
            = yield
          = render Schematics::Footer::Component.new
