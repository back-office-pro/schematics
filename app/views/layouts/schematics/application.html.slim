doctype html
html
  head
    meta charset="utf-8"
    meta name="turbolinks-cache-control" content="no-preview"
    title #{setting(:company_name)} - #{title}
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload'
    = stylesheet_link_tag 'schematics/themes/light', media: 'all', 'data-turbolinks-track': 'reload', id: 'light', disabled: user_setting(:theme) != 'light'
    = stylesheet_link_tag 'schematics/themes/dark', media: 'all', 'data-turbolinks-track': 'reload', id: 'dark', disabled: user_setting(:theme) != 'dark'
    = stylesheet_link_tag 'schematics/application', media: 'all', 'data-turbolinks-track': 'reload'
    = javascript_pack_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'https://www.gstatic.com/charts/loader.js'
    = javascript_include_tag 'schematics/application', 'data-turbolinks-track': 'reload'
    = timeago_script_tag
  body
    - flash.each do |f|
      = render Schematics::Toast::Component.new(flash: f)
    .container-fluid.p-0.h-100
      .row.no-gutters.h-100
        .col.bg-primary.sidebar class=('toggled' if user_setting(:sidebar_toggled))
          = render Schematics::Sidebar::Component.new
        .col.bg-light.content class=('toggled' if user_setting(:sidebar_toggled))
          nav.navbar.navbar-light.navbar-expand.border-0.p-0.sticky-top.shadow-sm
            = render Schematics::BreadcrumbTrail::Component.new
            ul.navbar-nav.ml-auto.p-3
              = render Schematics::SearchBar::Component.new
              = render Schematics::NotificationCenter::Component.new
              = render Schematics::MessageCenter::Component.new
              = render Schematics::SwitchTheme::Component.new
              = render Schematics::MyAccount::Component.new
          .container-fluid.my-4.px-4.animate__animated class=('animate__slideInDown' if params[:page].blank?)
            = yield
          footer.px-2.py-3.border-top
            .ml-3 &copy; #{setting(:company_name)} #{Time.zone.now.year}
