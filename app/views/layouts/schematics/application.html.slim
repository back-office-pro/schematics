doctype html
html
  head
    meta charset="utf-8"
    title #{app_name} - #{title}
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'schematics/application', media: 'all', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'schematics/application', 'data-turbolinks-track': 'reload'
  body
    .container-fluid.p-0.h-100
      .row.no-gutters.h-100
        .col.bg-primary.sidebar.border-right.border-white
          ul.nav.nav-light.flex-column.sidebar-sticky
            li.nav-item.mb-4
              = link_to app_name,
                schematics.root_path,
                class: "sidebar-brand d-flex align-items-center text-white text-nowrap justify-content-center"
            - Schematics::SCHEMA.entities.each do |entity|
              - model_class = entity.type.camelize.constantize
              li.nav-item.text-center.mw-100.mb-2
                = active_link_to main_app.polymorphic_path(model_class),
                  class: "nav-link p-0 m-0 text-secondary text-nowrap" do
                  = fa_icon entity.icon, size: "2x"
                  .mt-2.d-none.d-md-block= model_class.model_name.human.pluralize
              - if is_active_link? main_app.polymorphic_path(model_class)
                - entity.enum_attributes.each do |attribute|
                  li.nav-item.text-center.mw-100.mb-2.pl-3.pr-3.d-none.d-md-block
                    ul.list-group
                      - attribute.values.each do |value|
                        = active_link_to main_app.polymorphic_path(model_class, "by_#{attribute.name}": value),
                                          active: :exact,
                                          class: "nav-link p-0 m-0 text-secondary text-truncate segment" do
                          li.list-group-item.d-flex.justify-content-between.align-items-center.px-2.py-1.border-0.bg-transparent.rounded
                            span
                              = fa_icon :caret_right, class: "mr-2"
                              = model_class.human_enum_name(attribute.name.to_sym, value)
                            span.badge.badge-secondary.text-primary.badge-pill= model_class.send(:"#{attribute.name}_#{value}").count
              li.nav-item.mb-2
        .col.bg-light.content
          nav.navbar.navbar-light.navbar-expand.bg-white.border-0.p-0.sticky-top
            = form_tag schematics.searches_path, class: "d-sm-inline-block mw-100 ml-4 form-inline navbar-search" do
              .input-group
                = text_field_tag :query,
                  params[:query],
                  required: true,
                  placeholder: t('.search.placeholder'),
                  class: "form-control typeahead-search bg-light border-0 search" 
                .input-group-append
                  = button_tag fa_icon(:search), name: nil, class: "btn btn-primary"
            ul.navbar-nav.ml-auto.p-3
              li.nav-item.dropdown.no-arrow.d-flex.align-items-center.pr-3
                a#notificationsDropdown.nav-link.dropdown-toggle aria-expanded="false" aria-haspopup="true" data-toggle="dropdown" href="#" role="button" 
                  = fa_icon :bell, class: "fa-lg"
                  .badge.badge-danger 3
                .dropdown-menu.dropdown-menu-right.animated--grow-in.shadow-sm aria-labelledby="notificationsDropdown" 
                  h6.dropdown-header Header
                  .dropdown-item.d-flex.align-items-center
                    | Test
                  .dropdown-divider
                  = link_to "Voir toutes les notifications", main_app.messages_path, class: "dropdown-item text-muted small"
              li.nav-item.dropdown.no-arrow.d-flex.align-items-center.pl-3.pr-3.border-left.border-light
                a#messagesDropdown.nav-link.dropdown-toggle aria-expanded="false" aria-haspopup="true" data-toggle="dropdown" href="#" role="button" 
                  = fa_icon :envelope, class: "fa-lg"
                  .badge.badge-danger 7
                .dropdown-menu.dropdown-menu-right.animated--grow-in.shadow-sm aria-labelledby="messagesDropdown" 
                  h6.dropdown-header= t('.message_center')
                  - current_user.received_messages.each do |message|
                    = link_to main_app.message_path(message), class: "dropdown-item d-flex align-items-center" do
                      = fa_icon :user_circle, size: "2x", class: "mr-3"
                      div
                        .text-truncate= message.content
                        .text-muted.small #{message.author.full_name} - #{time_ago_in_words(message.created_at)}
                  .dropdown-divider
                  = link_to "Voir tous les messages", main_app.messages_path, class: "dropdown-item text-muted text-center small"
              li.nav-item.dropdown.no-arrow.d-flex.align-items-center.pl-2.border-left.border-light
                a#accountDropdown.nav-link.dropdown-toggle aria-expanded="false" aria-haspopup="true" data-toggle="dropdown" href="#" role="button" 
                  span.d-none.d-lg-inline.mr-2= current_user.full_name
                  - if current_user.avatar.attached?
                    = image_tag_representation(current_user.avatar, width: 30, height: 30, css_class: "rounded-circle border border-dark")
                  - else
                    = fa_icon :user_circle, size: "2x", class: "align-middle"
                .dropdown-menu.dropdown-menu-right.animated--grow-in.shadow-sm aria-labelledby="accountDropdown" 
                  = link_to schematics.profile_path, class: "dropdown-item" do
                    = fa_icon :user, class: "mr-3"
                    = t('.dropdown.edit_profile')
                  .dropdown-divider
                  = link_to schematics.logout_path, method: :delete, class: "dropdown-item" do
                    = fa_icon :sign_out_alt, class: "mr-3"
                    = t('.dropdown.logout')
          = render 'schematics/application/breadcrumbs'
          .container-fluid.mt-4.mb-4.pl-4.pr-4
            = render 'schematics/application/notice' if notice.present?
            = render 'schematics/application/alert' if alert.present?
            = yield
          footer.mb-4.p-2.border-top
            .ml-3 &copy; #{app_name} #{Time.zone.now.year}
