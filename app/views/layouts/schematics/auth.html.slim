doctype html
html
  head
    meta charset="utf-8"
    title= app_name
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "schematics/application", media: "all"
    = javascript_include_tag "schematics/application"
  body
    .jumbotron.p-0.m-0.rounded-0.d-flex.align-items-center.min-vh-100.bg-gradient-primary
      .container
        = render 'schematics/application/notice' if notice.present?
        = render 'schematics/application/alert' if alert.present?
        = yield
