- breadcrumb title, main_app.edit_polymorphic_path(@resource)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = render Schematics::CardHeading::Component.new(icon: :edit, title:)
      .col-auto
        = render Schematics::Button::Stale::Component.new(resource: @resource)
  .card-body.p-3
    = render Schematics::ResourceForm::Component.new(resource: @resource)
