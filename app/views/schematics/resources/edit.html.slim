- breadcrumb title, main_app.edit_polymorphic_path(@resource)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        h5.m-0.text-primary.text-truncate.font-weight-bold
          = fa_icon :edit, class: 'mr-3 ml-2 fa-lg align-middle'
          span.align-middle = title
      .col-auto
        - if @resource.errors.of_kind?(:base, :stale)
          = link_to schematics.version_path(@resource.versions.last),
                    class: 'btn btn-danger btn-sm btn-icon-split' do
            span.icon = fa_icon :exclamation_triangle
            span.text.d-none.d-lg-inline = t('schematics.application.button.stale')
  .card-body.p-3
    = render Schematics::ResourceForm::Component.new(resource: @resource)
