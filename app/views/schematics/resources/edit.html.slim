- breadcrumb title, edit_polymorphic_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = render Schematics::CardHeading::Component.new(icon: :pen_to_square, title:)
      .col-auto
        = render Schematics::Button::Help::Component.new(model_class:)
        = render Schematics::Button::Stale::Component.new(resource: @resource)
  .card-body.p-3
    = render Schematics::ResourceForm::Component.new(resource: @resource)
