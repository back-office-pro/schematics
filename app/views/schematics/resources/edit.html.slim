- breadcrumb title, edit_resource_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn {
  data-controller='auto-save'
  data-auto-save-timeago-outlet='.timeago'
  data-auto-save-draft-value=@draft.to_json
}
  .card-header.p-2
    .row.align-items-center
      .col.text-truncate.px-1
        = __card_heading(icon: :pen_to_square, title:)
      .col-auto
        = __button_help(model_class:)
        = __button_restore_draft(draft: @draft)
        = __button_draft
        = __button_stale(resource: @resource)
  .card-body.p-3.pt-1
    = __resource_form(resource: @resource)
= __viewer_documentation(model_class:)
