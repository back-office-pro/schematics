- breadcrumb title, main_app.polymorphic_path(@resource)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = render Schematics::CardHeading::Component.new(icon: :eye, title:)
      .col-auto
        = render Schematics::Button::GenerateFileInBackground::Component.build_pdf(url: main_app.polymorphic_path(@resource, format: :pdf))
        = render Schematics::Button::Edit::Component.new(resource: @resource, compact: false)
        = render Schematics::Viewer::EventButtonGroup::Component.new(resource: @resource, compact: false)
        - constant = resource_associations(resource: @resource, only_required: true).any? ? :Delete : :Destroy
        = render Schematics::Button.const_get(constant)::Component.new(resource: @resource, compact: false)
  .card-body.p-0
    = render template: 'schematics/resources/show', formats: :pdf
- entity.rich_text_attributes.each do |attribute|
  - rich_text = @resource.public_send(attribute.name)
  - if rich_text.present?
    .card.shadow-sm.border-0.mt-3
      a.card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1 {
        href="#collapse-#{attribute.name}"
        data-toggle='collapse'
        role='button'
      }
        = render Schematics::CardHeading::Component.new( \
          icon: attribute.icon,
          title: attribute.entity.class_name.constantize.human_attribute_name(attribute.name) \
        )
      .collapse.show id="collapse-#{attribute.name}"
        .card-body.p-3
          == rich_text
- resource_associations(resource: @resource).each do |resources|
  = render Schematics::Viewer::Association::Component.new(resources:)
- versions = Schematics::Version.timeline(versions: @resource.versions.includes(item: entity.includes), ability: current_ability)
- if versions.any?
  .mt-4
    .row.justify-content-center
      .col-xl-9.col-md-12
        ul.timeline.list-unstyled
          - versions.each do |version|
            li
              .timeline-icon.bg-primary
                = fa_icon version.icon, size: '2x', class: 'text-light'
              .card.border-0
                .card-body.p-3
                  = render Schematics::VersionPreview::Component.new(version:)
