- breadcrumb title, main_app.polymorphic_path(@resource)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        h5.m-0.text-primary.text-truncate.font-weight-bold
          = fa_icon :eye, class: 'mr-3 ml-2 fa-lg align-middle'
          span.align-middle = title
      .col-auto {
        data-controller='generateFileInBackground'
        data-generateFileInBackground-content-type='application/pdf'
        data-generateFileInBackground-url=main_app.polymorphic_path(@resource, format: :pdf)
      }
        a.btn.btn-light.btn-sm.btn-icon-split data-action='click->generateFileInBackground#run'
          span.icon data-generateFileInBackground-target='icon' = fa_icon :file_pdf
          span.text.d-none.d-lg-inline data-generateFileInBackground-target='text' = t('schematics.application.button.download_pdf')
        - if can?(:update, @resource)
          = link_to main_app.edit_polymorphic_path(entity.is_a?(Schematics::Entities::Singleton) ? model_class : @resource),
                    class: 'btn btn-primary btn-sm btn-icon-split ml-2' do
            span.icon = fa_icon :edit
            span.text.d-none.d-lg-inline = t('schematics.application.button.edit')
        = render Schematics::Viewer::EventButtonGroup::Component.new(resource: @resource, compact: false)
        - if can?(:destroy, @resource)
          - if resource_associations(only_required: true).any?
            = link_to main_app.polymorphic_path(@resource, action: :delete), class: 'btn btn-danger btn-sm btn-icon-split ml-2' do
                span.icon = fa_icon :trash
                span.text.d-none.d-lg-inline = t('schematics.application.button.destroy')
          - else
            = link_to main_app.polymorphic_path(@resource), method: :delete, class: 'btn btn-danger btn-sm btn-icon-split ml-2', data: confirm_data do
                span.icon = fa_icon :trash
                span.text.d-none.d-lg-inline = t('schematics.application.button.destroy')
  .card-body.p-0
    = render template: 'schematics/resources/show', formats: :pdf
- entity.rich_text_attributes.each do |attribute|
  - rich_text = @resource.public_send(attribute.name)
  - if rich_text.present?
    .card.shadow-sm.border-0.mt-3
      a.card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1 {
        href="#collapse-#{attribute.name}"
        data-toggle='collapse'
        role='button'
      }
        h5.m-0.text-primary.text-truncate.font-weight-bold
          = fa_icon attribute.icon, class: 'mr-3 ml-2 fa-lg'
          = attribute.entity.class_name.constantize.human_attribute_name(attribute.name)
      .collapse.show id="collapse-#{attribute.name}"
        .card-body.p-3
          == rich_text
- resource_associations.each do |resources|
  = render Schematics::Viewer::Association::Component.new(resources:)
- versions = Schematics::Version.timeline(versions: @resource.versions.includes(item: entity.includes), ability: current_ability)
- if versions.any?
  .mt-4
    .row.justify-content-center
      .col-xl-9.col-md-12
        ul.timeline.list-unstyled
          - versions.each do |version|
            li
              .timeline-icon.bg-primary
                = fa_icon version.icon, size: '2x', class: 'text-light'
              .card.border-0
                .card-body.p-3
                  = render Schematics::VersionPreview::Component.new(version:)
