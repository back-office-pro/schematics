- breadcrumb title, new_polymorphic_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn {
  data-controller='auto-save'
  data-auto-save-draft-value=@draft.to_json
}
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = component :card_heading, icon: :plus, title:
      .col-auto
        = component('button/help', model_class:)
        = component('button/restore_draft', draft: @draft)
        = component('button/draft')
  .card-body.p-3
    = component :resource_form, resource: @resource
= component 'viewer/documentation', model_class:
