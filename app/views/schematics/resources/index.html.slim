= form_with url: main_app.polymorphic_path(model_class),
            method: :get,
            data: { turbo_frame: 'viewer', controller: 'filters' },
            class: 'animate__animated animate__zoomIn' do
  = submit_tag nil, name: nil, class: 'd-none'
  = turbo_frame_tag 'viewer', data: { turbo_action: 'advance' } do
    - %i[sort items month_page].each do |query|
      = hidden_field_tag query, params[query]
    .card.shadow-sm.w-100
      .card-header.px-2.py-1
        .row.align-items-center
          .col.text-truncate
            = component :card_heading, icon: :table, title:
          .col-auto
            = component('button/generate_file_in_background', :csv, dropdown: @pagy.pages > 1) if @resources.any?
            = component('button/import', model_class:)
            = component('button/add', model_class:)
            = component('button/reset_filters', model_class:)
      .card-body.p-0
        = component(:placeholder, visible: false)
        = component(:viewer, :build, resources: @resources, viewer:)
    = component 'viewer/pagination', human_name_plural: @human_name_plural, pagy: @pagy, calendar: @calendar
