= turbo_frame_tag 'viewer', data: { turbo_action: 'advance' } do
  .card.shadow-sm.w-100
    .card-header.p-2
      .row.align-items-center
        .col.text-truncate.px-1
          = __card_heading(icon: :table, title:)
        .col-auto
          = __button_generate_file_in_background(:csv, dropdown: @pagy.pages > 1) if @resources.any?
          = __button_import(model_class:)
          = __button_add(model_class:)
          = __button_reset_filters(model_class:)
    .card-body.p-0
      = __placeholder(visible: false)
      = __filters_form(model_class:)
      = __viewer(:build, resources: @resources, viewer:)
  = __viewer_pagination(human_name_plural: @human_name_plural, pagy: @pagy, calendar: @calendar)
