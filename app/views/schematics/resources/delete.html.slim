- breadcrumb title, polymorphic_path(@resource, action: :delete)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
    = render Schematics::CardHeading::Component.new(icon: :trash, title:)
  .card-body.p-3
    .alert.alert-danger
      h5.alert-heading
        = fa_icon :exclamation_triangle, class: 'me-3'
        = t('schematics.application.delete.title')
      = t('schematics.application.delete.subtitle')
    .text-secondary = t('schematics.application.delete.warning', human_name: @human_name, gender: @gender, resource: @resource)
    = render Schematics::Viewer::Association::Component \
              .with_collection(resource_associations(resource: @resource, only: :required?), collapsed: true)
    = form_for @resource, method: :delete, data: { controller: 'form' }, html: { class: 'mt-3' } do
      = render Schematics::Button::Confirm::Component.new
      = render Schematics::Button::Cancel::Component.new(path: @resource)
