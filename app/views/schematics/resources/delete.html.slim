- breadcrumb title, delete_resource_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-1.py-2
    = __card_heading(icon: :trash, title:)
  .card-body.p-3.pt-1
    = __delete_alert
    = __delete_associations_warning(resource: @resource)
    = form_with model: @resource, url: resource_path(@resource), method: :delete, class: 'mt-3' do
      = __button_confirm
      = __button_cancel(path: resource_path(@resource))
