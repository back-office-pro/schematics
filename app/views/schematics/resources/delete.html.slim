- breadcrumb title, polymorphic_path(@resource, action: :delete)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
    = __card_heading(icon: :trash, title:)
  .card-body.p-3
    .alert.alert-danger
      h5.alert-heading
        = fa_icon :triangle_exclamation, class: 'me-3'
        = t('schematics.application.delete.title')
      = t('schematics.application.delete.subtitle')
    .text-secondary = t('schematics.application.delete.warning', human_name: @human_name, gender: @gender, resource: @resource)
    = __viewer_association(@resource.associations(current_ability, dependent: true))
    = form_with model: @resource, method: :delete, class: 'mt-3' do
      = __button_confirm
      = __button_cancel(path: @resource)
