- breadcrumb title, schematics.versions_path
.row.g-0.align-items-center
  .col-lg
    .card.shadow-sm.border-0
      .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
        .row.align-items-center
          .col.text-truncate
            = render Schematics::CardHeading::Component.new(icon: @version.entity.icon, title:)
          .col-auto
            = render Schematics::Button::Revert::Component.new(version: @version)
      .card-body.p-0
        = render Schematics::ResourceDetails::Component.new(resource: @version.reify(dup: true))
  .col-lg-1.my-3.mx-0.text-center
    = fa_icon :arrow_right, size: '4x', class: 'text-secondary d-none d-lg-inline-block'
    = fa_icon :arrow_down, size: '4x', class: 'text-secondary d-inline-block d-lg-none'
  .col-lg
    .card.shadow-sm.border-0
      .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
        .row.align-items-center
          .col.text-truncate
            = render Schematics::CardHeading::Component.new(icon: @version.entity.icon, title:)
      .card-body.p-0
        = render Schematics::ResourceDetails::Component.new(resource: @version.item)
