- breadcrumb title, schematics.versions_path
= turbo_frame_tag 'versions', data: { turbo_action: 'advance' } do
  .row.justify-content-center
    .col-xl-9.col-md-12.position-relative
      ul.timeline.list-unstyled
        - @versions.each do |version|
          li
            .timeline-icon.bg-primary
              = link_to fa_icon(version.entity.icon, size: '2x'),
                        main_app.polymorphic_path(version.model_class),
                        class: 'text-light',
                        data: { turbo_frame: '_top' }
            .card.border-0.animate__animated.animate__zoomIn
              .card-body.p-3
                = render Schematics::VersionPreview::Component.new(version:)
  = render Schematics::Viewer::Pagination::Component.new(pagy: @pagy)
