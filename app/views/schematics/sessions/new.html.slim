.d-flex.justify-content-center.text-white.mb-4.pb-4
  = render Schematics::Attachment::Component.company_logo(attachment: settings(:company_logo), icon: :door_open)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
    = render Schematics::CardHeading::Component.new(icon: :sign_in_alt, title:)
  .card-body.p-3
    = simple_form_for :user, url: sessions_path, wrapper: :input_group do |f|
      = f.input :email, prepend: fa_icon(:envelope)
      = render Schematics::Input::Password::Component.new(form: f)
      = f.input :remember_me, as: :boolean
      = render Schematics::Button::Confirm::Component.new
      = link_to t('.password_lost?'), password_lost_path, class: 'btn btn-link btn-sm text-decoration-none'
