.d-flex.justify-content-center.text-white.mb-4.pb-4
  = render Schematics::Attachment::Component.build_company_logo(attachment: settings(:company_logo), icon: :door_open)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :sign_in_alt, class: 'mr-3 ml-2 fa-lg align-middle'
      span.align-middle = title
  .card-body.p-3
    = simple_form_for :user, url: sessions_path, wrapper: :input_group do |f|
      = f.input :email, prepend: fa_icon(:envelope)
      = f.input :password, prepend: fa_icon(:key)
      = f.input :remember_me, as: :boolean
      = f.button :button, class: 'btn-primary btn-icon-split mr-2' do
        span.icon = fa_icon :check
        span.text = t('schematics.application.button.confirm')
      = link_to t('.password_lost?'), password_lost_path, class: 'btn btn-link btn-sm'
