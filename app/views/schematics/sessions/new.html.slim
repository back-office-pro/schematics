.d-flex.justify-content-center.text-white.mb-4.pb-4
  = cell('schematics/attachment',
         setting(:company_logo),
         width: 300,
         height: 150,
         replacement: { icon: :door_open, size: "7x" }).()
.card.shadow-sm
  .card-header.p-2
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :sign_in_alt, class: "mr-3 ml-3 fa-lg align-middle"
      span.align-middle= title
  .card-body
    = simple_form_for :user, url: sessions_path, wrapper: :input_group, defaults: { input_html: { class: "bg-light border-0" } } do |f|
      = f.input :email, prepend: fa_icon(:envelope)
      = f.input :password, prepend: fa_icon(:key)
      = f.input :remember_me, as: :boolean
      = f.button :button, class: "btn-primary btn-icon-split mr-2" do
        span.icon= fa_icon :check
        span.text= t('schematics.application.form.buttons.confirm')
      = link_to t('.password_lost?'), password_lost_path, class: "btn btn-link btn-sm"
