= form_tag sessions_path do |form|
  .form-group
    = label_tag :email
    = text_field_tag :email, nil, class: "form-control bg-light border-0"
  .form-group
    = label_tag :password
    = password_field_tag :password, nil, class: "form-control bg-light border-0"
  = submit_tag "Connexion", class: "btn btn-primary"
  