.d-flex.justify-content-center.text-white.mb-4.pb-4
  = fa_icon :door_open, size: "7x"
.card.shadow-sm
  .card-header
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :sign_in_alt, class: "mr-2"
      = title
  .card-body
    = simple_form_for :user, url: sessions_path, defaults: { input_html: { class: "bg-light border-0" } } do |f|
      = f.input :email
      = f.input :password
      = f.input :remember_me, as: :boolean
      = f.button :button, class: "btn-primary btn-icon-split mr-2" do
        span.icon= fa_icon :check
        span.text= t('schematics.application.form.buttons.confirm')
      = link_to t('.password_lost?'), password_lost_path, class: "btn btn-link"
