- breadcrumb title, profile_path
.card.shadow-sm
  .card-header.p-2
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :user, class: "mr-3 ml-3 fa-lg align-middle"
      span.align-middle= title
  .card-body
    = cell('schematics/form', 
           current_user,
           url: sessions_path,
           attributes: attributes,
           cancel_path: root_path).()
