.card.shadow-lg
  .card-header
    h5.m-0.text-primary.font-weight-bold
      = fa_icon :user, class: "mr-2"
      | Editer mon profil
  .card-body
    = simple_form_for current_user, url: sessions_path, defaults: { input_html: { class: "bg-light border-0" } } do |f|
      = f.input :email
      = f.input :locale, collection: User.locales.keys.map(&:to_sym), include_blank: false
      = f.input :password
      = f.input :password_confirmation
      = f.input :current_password
      = f.button :button, class: "btn-primary btn-icon-split mr-2" do
        span.icon= fa_icon :check
        span.text Valider  
      = link_to root_path, class: "btn btn-danger btn-icon-split" do
        span.icon= fa_icon :times
        span.text Annuler
