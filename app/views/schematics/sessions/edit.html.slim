- breadcrumb title, profile_path
.card.shadow-sm.border-0
  .card-header.border-top-0.border-left-0.border-right-0.border-light.p-2
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :user, class: 'mr-3 ml-2 fa-lg align-middle'
      span.align-middle = title
  .card-body.p-3
    = render Schematics::ResourceForm::Component.new(resource: current_user, url: sessions_path, attributes: attributes, cancel_path: root_path)
