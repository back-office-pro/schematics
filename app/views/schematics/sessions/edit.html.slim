- breadcrumb title, profile_path
.card.shadow-sm
  .card-header.p-2
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :user, class: "mr-3 ml-3 fa-lg align-middle"
      span.align-middle= title
  .card-body
    - avatar = entity.find_field_by_name('avatar')
    - locale = entity.find_field_by_name('locale')
    = simple_form_for current_user, url: sessions_path, validate: true, defaults: { input_html: { class: "bg-light border-0" } } do |f|
      = f.input :email
      = f.input :password
      = f.input :password_confirmation
      = f.input :current_password
      = f.input :first_name
      = f.input :last_name
      - if current_user.avatar.attached?
        = f.simple_fields_for :avatar_attachment_attributes do |fields|
          = fields.hidden_field :id, value: current_user.avatar.id
          = fields.input :_destroy, as: :boolean, wrapper_html: { class: "float-right m-0" } 
      = f.input :avatar,
                as: :file,
                hint: cell('schematics/validators', avatar).()
      = f.input :locale,
                as: :radio_buttons,
                collection: locale.input_collection.map(&:reverse)
      = f.button :button, class: "btn btn-primary btn-sm btn-icon-split mr-2" do
        span.icon= fa_icon :check
        span.text= t('schematics.application.form.buttons.confirm')
      = link_to root_path, class: "btn btn-danger btn-sm btn-icon-split" do
        span.icon= fa_icon :times
        span.text= t('schematics.application.form.buttons.cancel')
