- breadcrumb title, profile_path
.card.shadow-sm
  .card-header.p-2
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :user, class: "mr-3 ml-3"
      = title
  .card-body
    = simple_form_for current_user, url: sessions_path, defaults: { input_html: { class: "bg-light border-0" } } do |f|
      = f.input :email
      = f.input :password
      = f.input :password_confirmation
      = f.input :current_password
      = f.input :first_name
      = f.input :last_name
      = f.input :avatar,
                as: :file,
                hint: fa_icon(:info_circle, class: "mr-1") + \
                  humanize_attachment_validators(User.entity.find_field_by_name('avatar').validators)
      = f.input :locale,
                as: :radio_buttons,
                collection: User.locales.keys.collect { |key| [User.entity.find_field_by_name('locale').format(key), key] },
                include_blank: false
      = f.button :button, class: "btn btn-primary btn-sm btn-icon-split mr-2" do
        span.icon= fa_icon :check
        span.text= t('schematics.application.form.buttons.confirm')
      = link_to root_path, class: "btn btn-danger btn-sm btn-icon-split" do
        span.icon= fa_icon :times
        span.text= t('schematics.application.form.buttons.cancel')
