- breadcrumb title, :search_path, match: :inclusive
- if @results.empty?
  .card.shadow-sm.mb-4
    .card-header
      h5.m-0.text-primary.text-truncate.font-weight-bold
        = fa_icon :search, class: "mr-2"
        = title
    .card-body.text-center
      = render 'schematics/application/empty'
- else
  - @results.each do |type, resources|
    - model_class = resources.first.class
    .card.shadow-sm.mb-4
      a.card-header href="#collapse-#{type}" data-toggle="collapse" role="button"
        h5.m-0.text-primary.text-truncate.font-weight-bold
          = fa_icon :search, class: "mr-2"
          = model_class.model_name.human(count: resources.size)
          |  (#{resources.size})
      .collapse.show id="collapse-#{type}"
        .card-body
          = render 'schematics/application/table',
            resources: resources,
            entity: model_class.entity,
            model_class: model_class,
            actions: false
