- breadcrumb title, :search_path, match: :inclusive
- if @results.empty?
  .card.shadow-sm.mb-4
    .card-header.p-2
      h5.m-0.text-primary.text-truncate.font-weight-bold
        = fa_icon :search, class: "mr-3 ml-3 fa-lg align-middle"
        span.align-middle= title
    .card-body.text-center
      = render 'schematics/application/empty'
- else
  - @results.each do |name, resources|
    - model_class = resources.first.class
    = render 'schematics/application/viewers/association',
        resources: resources,
        title: model_class.model_name.human(count: resources.size),
        icon: model_class.entity.icon,
        entity: model_class.entity,
        model_class: model_class,
        collapsed: false
