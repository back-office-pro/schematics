- breadcrumb title, schematics.search_path, match: :inclusive
- if @results.empty?
  .card.shadow-sm.border-0.mb-4
    .card-header.border-bottom.border-light.p-2
      h5.m-0.text-primary.text-truncate.font-weight-bold
        = fa_icon :search, class: 'mr-3 ml-2 fa-lg align-middle'
        span.align-middle = title
    .card-body.text-center.p-3
      = render Schematics::EmptyResource::Component.new(suggestions: @suggestions)
- else
  - @results.each do |_name, resources|
    = render Schematics::Viewer::Association::Component.new(resources: resources)
