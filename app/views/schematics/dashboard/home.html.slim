.row
  - Schematics::SCHEMA.stats.each do |stat|
    .col-xl-3.col-md-6.mb-4
      .card.shadow-sm
        .card-body
          .row.no-gutters.align-items-center
            .col
              small.text-uppercase.text-primary.font-weight-bold
                = stat.title
              h5.mb-0.text-dark.text-truncate.font-weight-bold
                = stat
            .col-auto.text-light
              = fa_icon stat.icon, size: "2x"
  - Schematics::SCHEMA.charts.each do |chart|
    .col-xl-6.col-md-12.mb-4
      .card.shadow-sm
        .card-header.p-2
          h5.m-0.text-primary.text-truncate.font-weight-bold
            = fa_icon chart.icon, class: "mr-3 ml-3"
            = chart.title
        .card-body
          = send chart.type,
                 chart.to_h,
                 xtitle: chart.x.title.humanize,
                 ytitle: chart.y.title.humanize,
                 suffix: chart.y.field&.try(:unit),
                 download: { filename: chart.title.parameterize }
