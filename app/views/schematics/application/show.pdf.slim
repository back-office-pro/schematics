.table-responsive
  table.table.mb-0.table-striped
    tbody.table-bordered.border-0
      - (entity.renderable_fields - \
         entity.rich_text_attributes - \
         entity.attachments_attributes - \
         entity.belongs_to_attributes). \
         each do |field|
        tr
          th
            = fa_icon field.icon, class: "mr-2 text-muted"
            = model_class.human_attribute_name(field.name)
          td
            - value = @resource.instance_eval(field.name)
            - case field
            - when Schematics::Attributes::Attachments
              - value.each do |attachment|
                - if attachment.representable?
                  = image_tag_representation(attachment)
                - else
                  = link_to attachment.filename, attachment
            - when Schematics::Attributes::Attachment
              - if value.attached?
                - if value.representable?
                  = image_tag_representation(value)
                - else
                  = link_to value.filename, value
            - when Schematics::Attributes::Boolean
              = value ? fa_icon(:check, class: "text-success") : fa_icon(:times, class: "text-danger")
            - when Schematics::Attributes::RichText
              == value
            - else
              = field.format(value)
      - entity.belongs_to_attributes.each do |attribute|
        tr
          th
            = fa_icon attribute.icon, class: "mr-2 text-muted"
            = model_class.human_attribute_name(attribute.name)
          td
            - value = @resource.instance_eval(attribute.name)
            = link_to(value, value) if value
      - entity.has_one_and_through_associations.each do |association|
        tr
          th
            = fa_icon association.icon, class: "mr-2 text-muted"
            = model_class.human_attribute_name(association.name)
          td
            - value = @resource.instance_eval(association.name)
            = link_to(value, value) if value
