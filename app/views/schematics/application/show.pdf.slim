.table-responsive
  table.table.mb-0.table-striped
    tbody.table-bordered.border-0
      - (entity.renderable_fields - \
         entity.rich_text_attributes - \
         entity.attachments_attributes - \
         entity.association_attributes). \
         each do |field|
        tr
          th
            = fa_icon field.icon, class: "mr-2 text-muted"
            = model_class.human_attribute_name(field.name)
          td
            - value = @resource.instance_eval(field.name)
            - case field
            - when Schematics::Attributes::Address
              = cell('schematics/google_map', value).()
            - when Schematics::Behaviours::Editable
              = best_in_place @resource,
                              field.name.to_sym,
                              as: field.input_type,
                              inner_class: "form-control border p-0",
                              collection: field.try(:input_collection),
                              display_with: lambda { |value| field.format(value) }
            - when Schematics::Attributes::Attachments
              - value.each do |attachment|
                - if attachment.representable?
                  = cell('schematics/attachment', attachment).()
                - else
                  = link_to attachment.filename, attachment
            - when Schematics::Attributes::Attachment
              - if value.attached?
                = form_for @resource do |f|
                  = f.fields_for :"#{value.name}_attachment_attributes" do |fields|
                    = fields.hidden_field :id, value: value.id
                    = fields.hidden_field :_destroy, value: true
                  = f.button :button,
                              class: "btn btn-danger btn-sm float-right",
                              data: { toggle: "tooltip", placement: "left", title: I18n.t('schematics.application.show.buttons.destroy') } do
                                = fa_icon(:trash)
                - if value.representable?
                  = cell('schematics/attachment', value).()
                - else
                  = link_to value.filename, value
            - when Schematics::Attributes::Boolean
              = value ? fa_icon(:check, class: "text-success") : fa_icon(:times, class: "text-danger")
            - when Schematics::Attributes::RichText
              == value
            - else
              = field.format(value)
      - entity.association_attributes.each do |attribute|
        tr
          th
            = fa_icon attribute.icon, class: "mr-2 text-muted"
            = model_class.human_attribute_name(attribute.name)
          td
            = best_in_place @resource,
                            attribute.column_name.to_sym,
                            as: attribute.input_type,
                            collection: attribute.input_collection,
                            inner_class: "form-control border p-0"
      - entity.renderable_associations.each do |association|
        tr
          th
            = fa_icon association.icon, class: "mr-2 text-muted"
            = model_class.human_attribute_name(association.name)
          td
            - value = @resource.instance_eval(association.name)
            = link_to(value, value) if value
