.table-responsive
  table.table.table-striped
    tbody
      - (entity.attributes - entity.references + entity.virtuals).select(&:visible?).each do |field|
        tr
          th
            = fa_icon field.icon, class: "mr-2 text-muted"
            = field.name.humanize
          td= field.format(@resource.instance_eval(field.name))
      - entity.references.each do |reference|
        tr
          th
            = fa_icon reference.icon, class: "mr-2 text-muted"
            = reference.name.humanize
          td
            = link_to @resource.instance_eval("#{reference.name}.#{reference.inverse_descriptor.name}"), @resource.instance_eval(reference.name)
      - (entity.has_one_associations + entity.has_one_through_associations).each do |association|
        tr
          th
            = fa_icon association.icon, class: "mr-2 text-muted"
            = association.name.humanize
          td= link_to @resource.instance_eval("#{association.name}.#{association.descriptor.name}"), @resource.instance_eval(association.name)
