= simple_form_for resource, defaults: { input_html: { class: "bg-light border-0" } } do |f|
  - (entity.attributes - entity.references).reject_is_a?(Schematics::Attributes::Token).each do |attribute|
    - if attribute.is_a?(Schematics::Attributes::RichText)
      = f.input attribute.name.to_sym, as: :rich_text_area
    - elsif attribute.is_a?(Schematics::Attributes::Enum)
      = f.input attribute.name.to_sym, collection: model_class.send(attribute.name.pluralize.to_sym).keys.map(&:to_sym), include_blank: false
    - elsif attribute.is_a?(Schematics::Attributes::Attachments)
      = f.input attribute.name.to_sym, as: :file, input_html: { multiple: true }
    - elsif attribute.is_a?(Schematics::Attributes::Digest)
      = f.input attribute.name.to_sym
      = f.input "#{attribute.name}_confirmation".to_sym
    - else
      = f.input attribute.name.to_sym
  - entity.references.each do |reference|
    = f.association reference.name.to_sym, label_method: find_descriptor_by_reference(reference).name.to_sym, prompt: "Please select"
  = f.button :button, class: "btn-primary btn-icon-split mr-2" do
    span.icon= fa_icon :check
    span.text Valider
  = link_to 'Annuler', url_for(action: :index), class: "btn btn-link"
