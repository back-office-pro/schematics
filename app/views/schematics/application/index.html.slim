= form_tag '', method: :get, class: 'form-inline mb-3' do
  = submit_tag 'Filtrer', name: nil, class: 'd-none'
  .card.shadow-sm.border-0.w-100
    .card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1
      .row.align-items-center
        .col.text-truncate
          h5.m-0.text-primary.text-truncate.font-weight-bold
            = fa_icon :table, class: 'mr-3 ml-2 fa-lg align-middle'
            span.align-middle = title
        .col-auto {
          data-controller='generateFileInBackground'
          data-generateFileInBackground-content-type='text/csv'
          data-generateFileInBackground-url=polymorphic_path(model_class, format: :csv)
        }
          - if @pagy.pages > 1
            = select_tag :per_page,
              options_for_select([10, 25, 50, 100].map do |size| \
                [t('schematics.application.dropdown.per_page', size: size, model_name: @model_name_plural), size] \
              end, params.fetch(:per_page, 25)),
              onchange: '$(this.form).submit()',
              class: 'form-control form-control-sm border-0 bg-transparent d-none d-md-inline'
          a.btn.btn-light.btn-sm.btn-icon-split.ml-2 data-action='click->generateFileInBackground#run'
            span.icon data-generateFileInBackground-target='icon' = fa_icon :file_csv
            span.text.d-none.d-lg-inline data-generateFileInBackground-target='text' = t('schematics.application.button.download_as_csv')
          - if can?(:import, model_class)
            = link_to polymorphic_path(model_class, action: :import), class: 'btn btn-dark btn-sm btn-icon-split ml-2' do
              span.icon = fa_icon :cloud_upload_alt
              span.text.d-none.d-lg-inline = t('schematics.application.button.import', model_name: @model_name_plural)
          - if can?(:create, model_class)
            = link_to new_polymorphic_path(model_class), class: 'btn btn-primary btn-sm btn-icon-split ml-2' do
              span.icon = fa_icon :plus
              span.text.d-none.d-lg-inline = t('schematics.application.button.add', model_name: @model_name)
          - unless params.except(:controller, :action, :locale, :page, :per_page).empty?
            = link_to polymorphic_path(model_class), class: 'btn btn-danger btn-sm btn-icon-split ml-2' do
              span.icon = fa_icon :eraser
              span.text.d-none.d-lg-inline = t('schematics.application.button.reset_filters')
    .card-body.p-0
      = render Schematics::Viewer::Component.create(resources: @resources)
== pagy_bootstrap_nav_js(@pagy) if @pagy.pages > 1
