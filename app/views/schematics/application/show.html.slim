= render 'notice'
.card.shadow
  .card-header
    ul.nav
      li.nav-item
        h5.m-0.text-primary.font-weight-bold.card-header-title
          = fa_icon :eye, class: "mr-2"
          = @resource.send(entity.descriptor.name.to_sym)
      li.nav-item.ml-auto
        = link_to edit_polymorphic_path(@resource), class: "btn btn-primary mr-2" do
          = fa_icon :edit, class: "mr-2"
          | Editer
        = link_to url_for(action: :show, id: @resource.id, format: :pdf), class: "btn btn-info mr-2" do
          = fa_icon :file_pdf, class: "mr-2"
          | Télécharger au format PDF
        = link_to @resource, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" do
          = fa_icon :trash, class: "mr-2"
          | Supprimer définitivement
  .card-body
    = render template: 'schematics/application/show.pdf'
    = link_to 'Retour', url_for(action: :index), class: "btn btn-link"
