- breadcrumb title, polymorphic_path(model_class, action: :import)
.card.shadow-sm
  .card-header.p-2
    .row.align-items-center
      .col.text-truncate
        h5.m-0.text-primary.text-truncate.font-weight-bold
          = fa_icon :cloud_upload_alt, class: "mr-3 ml-3 fa-lg align-middle"
          span.align-middle= title
      .col-auto.mr-1
        = link_to polymorphic_path(model_class, format: :csv, per_page: 1), class: "btn btn-primary btn-sm btn-icon-split mr-2" do
          span.icon= fa_icon :file_csv
          span.text.d-none.d-lg-inline= t('.buttons.download_as_csv')
  .card-body
    .table-responsive
      table.table.table-striped.table-bordered
        thead
          tr
            - (entity.renderable_attributes - entity.association_attributes + entity.association_attributes + entity.renderable_associations).each do |element|
              th.text-nowrap.text-center
                = model_class.human_attribute_name(element.name)
        tbody
          - 3.times do
            tr
              - (entity.renderable_attributes - entity.association_attributes + entity.association_attributes + entity.renderable_associations).each do |element|
                td.text-nowrap.text-center
                  = element.type
      - @errors&.each do |line, error|
        = line
        = error
      = simple_form_for :import, url: polymorphic_path(model_class, action: :bulk_insert), defaults: { input_html: { class: "bg-light border-0" } } do |f|
        = f.input :file, as: :file
        = f.button :button, class: "btn btn-primary btn-sm btn-icon-split mr-2" do
          span.icon= fa_icon :check
          span.text= t('schematics.application.form.buttons.confirm')
        = link_to schematics.root_path, class: "btn btn-danger btn-sm btn-icon-split" do
          span.icon= fa_icon :times
          span.text= t('schematics.application.form.buttons.cancel')
