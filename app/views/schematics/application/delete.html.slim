- breadcrumb title, polymorphic_path(@resource, action: :delete)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-left-0.border-right-0.border-light.p-2
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :trash, class: 'mr-3 ml-2 fa-lg align-middle'
      span.align-middle = title
  .card-body.p-3
    .alert.alert-danger
      h5.alert-heading
        = fa_icon :exclamation_triangle, class: 'mr-3'
        = t('.title')
      = t('.subtitle')
    .text-dark = t('.warning', model_name: @model_name, resource: @resource)
    - resource_associations(only_required: true).each do |resources|
      = render Schematics::Viewer::Association::Component.new(resources: resources, collapsed: true)
    .mt-4
      = link_to polymorphic_path(@resource), method: :delete, class: 'btn btn-primary btn-sm btn-icon-split mr-2' do
        span.icon = fa_icon :check
        span.text = t('schematics.application.button.confirm')
      = link_to @resource, class: 'btn btn-danger btn-sm btn-icon-split' do
        span.icon = fa_icon :times
        span.text = t('schematics.application.button.cancel')
