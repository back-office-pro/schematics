.table-responsive
  table.table class=('with-actions' if actions) class=(['table-striped', 'table-hover'] unless resources.empty?)
    thead
      tr
        - if actions
          th.text-nowrap.text-center
            = fa_icon :archive, class: "mr-2 text-dark"
            = t('.archives')
        - (entity.renderable_fields - entity.belongs_to_attributes).each do |field|
          th.text-nowrap.text-center
            - if actions 
              = sort_link_to(field) 
            - else
              = fa_icon field.icon, class: "mr-2 text-dark"
              = model_class.human_attribute_name(field.name)
        - entity.belongs_to_attributes.each do |attribute|
          th.text-nowrap.text-center
            - if actions 
              = sort_link_to(attribute) 
            - else
              = fa_icon attribute.icon, class: "mr-2 text-dark"
              = model_class.human_attribute_name(attribute.name)
        - entity.has_one_and_through_associations.each do |association|
          th.text-nowrap.text-center
            - if actions 
              = sort_link_to(association) 
            - else
              = fa_icon association.icon, class: "mr-2 text-dark"
              = model_class.human_attribute_name(association.name)
      - if actions
        tr
          th.text-nowrap.align-middle.px-0
            = render 'schematics/application/filters/with_deleted'
          - (entity.renderable_fields - entity.belongs_to_attributes).each do |field|
            th.align-middle.text-center.px-0
              - case field
              - when Schematics::Attributes::Boolean
                = render 'schematics/application/filters/boolean', field: field
              - when Schematics::Virtuals::Calculation, Schematics::Attributes::Float
                = render 'schematics/application/filters/range', field: field
              - when Schematics::Attributes::Date
                = render 'schematics/application/filters/date', field: field
              - when Schematics::Attributes::Enum
                = render 'schematics/application/filters/enum', field: field
              - else
                = render 'schematics/application/filters/input', field: field
          - entity.belongs_to_attributes.each do |attribute|
            th.align-middle.text-center.px-0
              = render 'schematics/application/filters/belongs_to', attribute: attribute
          - entity.has_one_and_through_associations.each do |association|
            th.align-middle.text-center.px-0
              = render 'schematics/application/filters/association', association: association
      tbody
        - if resources.empty?
          tr
            td.text-center.pt-5 colspan="100%"
              = render 'empty'
        - else
          - resources.each do |resource|
            tr class=('disabled' if resource.deleted?) onclick=("window.location = '#{main_app.polymorphic_path(resource)}'" unless resource.deleted?)
              - if actions
                td.text-nowrap.text-left
                  .btn-group.enabled
                    - if resource.deleted?
                      = link_to fa_icon(:trash_restore),
                        main_app.polymorphic_path(resource),
                        method: :delete,
                        class: "btn btn-danger btn-sm",
                        data: { toggle: "tooltip", placement: "top", title: t('.restore') }
                    - else
                      = link_to main_app.edit_polymorphic_path(resource),
                        class: "btn btn-primary btn-sm",
                        data: { toggle: "tooltip", placement: "top", title: t('.edit') } do
                        = fa_icon :edit
                      = link_to fa_icon(:archive),
                        main_app.polymorphic_path(resource),
                        method: :delete,
                        class: "btn btn-danger btn-sm",
                        data: { toggle: "tooltip", placement: "top", title: t('.archive') }
              - (entity.renderable_fields - entity.belongs_to_attributes).each do |field|
                td.text-nowrap.text-center
                  - value = resource.instance_eval(field.name)
                  - case field
                  - when Schematics::Attributes::Attachments
                    - value.each do |attachment|
                      = link_to attachment.filename, main_app.url_for(attachment)
                  - when Schematics::Attributes::Attachment
                    = link_to value.filename, main_app.url_for(value) if value.attached?
                  - when Schematics::Attributes::Boolean
                    = value ? fa_icon(:check, class: "text-success") : fa_icon(:times, class: "text-danger")
                  - when Schematics::Attributes::Enum
                    = model_class.human_enum_name(field.name.to_sym, value)
                  - when Schematics::Behaviours::Searchable, !actions
                    = highlight field.format(value), params[:query]
                  - else
                    = field.format(value)
              - entity.belongs_to_attributes.each do |attribute|
                td.text-nowrap.text-center
                  - if resource.instance_eval(attribute.name).present?
                    = link_to resource.instance_eval("#{attribute.name}.#{attribute.inverse_descriptor.name}"),
                      main_app.polymorphic_path(resource.instance_eval(attribute.name))
              - entity.has_one_and_through_associations.each do |association|
                td.text-nowrap.text-center
                  - if resource.instance_eval(association.name).present?
                    = link_to resource.instance_eval("#{association.name}.#{association.descriptor.name}"),
                      main_app.polymorphic_path(resource.instance_eval(association.name))
