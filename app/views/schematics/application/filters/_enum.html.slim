.input-group.ml-1.mr-1.mb-2
  = render 'schematics/application/filters/eraser', name: field.name
  = select_tag :"by_#{field.name}",
    options_for_select( \
      model_class.send(field.name.pluralize.to_sym).keys.collect do |key| \
        [model_class.human_enum_name(field.name.to_sym, key), key] \
      end, \
      params[:"by_#{field.name}"] \
    ),
    prompt: t('schematics.application.filters.filter_by', attribute_name: model_class.human_attribute_name(field.name).downcase),
    onchange: "$(this.form).submit()", class: "form-control bg-light #{'border-0' unless params[:"by_#{field.name}"].present?}"
