.input-group.mx-1.mb-2.mt-1
  = search_form.search_field :"#{field.name}_cont",
                             value: params.dig(:q, :"#{field.name}_cont"),
                             id: field.name.camelize(:lower),
                             placeholder: t('schematics.application.filters.filter_by', attribute_name: model_class.human_attribute_name(field.name).downcase),
                             class: "form-control typeahead-filter bg-light border-success #{'border-0' if params.dig(:q, :"#{field.name}_cont").nil?}"
