.input-group.mx-1.mb-2.mt-1
  = search_field_tag "filter[#{field.name}]",
                     params.dig(:filter, field.name.to_sym),
                     id: field.name.camelize(:lower),
                     placeholder: t('schematics.application.filters.filter_by', attribute_name: model_class.human_attribute_name(field.name).downcase),
                     class: "form-control typeahead-filter bg-light border-success #{'border-0' if params.dig(:filter, field.name.to_sym).nil?}"
