.input-group.mr-sm-2.mb-2
  = render 'schematics/application/filters/eraser', name: association.name
  = select_tag "by_#{association.name}".to_sym, options_from_collection_for_select(association.name.camelize.constantize.all, "id", association.entity.descriptor.name, params["by_#{association.name}".to_sym]), prompt: "Filtrer par #{association.name.humanize}", onchange: "this.form.submit()", class: "form-control bg-light #{'border-0' unless params["by_#{association.name}".to_sym].present?}"
