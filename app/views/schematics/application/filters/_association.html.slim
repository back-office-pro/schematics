.input-group.mr-sm-2.mb-2
  - if params["by_#{association.name}".to_sym].present?
    .input-group-prepend
      .input-group-text
        = button_tag onclick: "this.form.by_#{association.name}.value = ''", class: "btn p-0" do
          = fa_icon :eraser
  = select_tag "by_#{association.name}".to_sym, options_from_collection_for_select(association.name.camelize.constantize.all, "id", association.entity.descriptor.name, params["by_#{association.name}".to_sym]), prompt: "Filtrer par #{association.name.humanize}", onchange: "this.form.submit()", class: "form-control #{'border-primary' if params["by_#{association.name}".to_sym].present?}"
