.input-group.mx-1.mb-2.mt-1
  - type = field.try(:input_type) || :number
  = send :"#{type}_field_tag", "filter[#{field.name}][gte]",
                               params.dig(:filter, field.name, :gte),
                               placeholder: t('schematics.application.filters.from'),
                               onchange: ("$(this.form).submit()" if type == :date),
                               class: "form-control bg-light rounded border-success #{'border-0' if params.dig(:filter, field.name, :gte).nil?}"
  - if field.try(:unit).present?
    .input-group-append
      .input-group-text.border-0.bg-transparent.p-0.pl-2
        = field.unit
  .mr-2
  = send :"#{type}_field_tag", "filter[#{field.name}][lte]",
                               params.dig(:filter, field.name, :lte),
                               placeholder: t('schematics.application.filters.to'),
                               onchange: ("$(this.form).submit()" if type == :date),
                               class: "form-control bg-light rounded border-success #{'border-0' if params.dig(:filter, field.name, :lte).nil?}"
  - if field.try(:unit).present?
    .input-group-append
      .input-group-text.border-0.bg-transparent.p-0.pl-2
        = field.unit
