{
  "name": "<%= Configuration.company_name %>",
  "short_name": "<%= Configuration.company_name %>",
  "background_color": "<%= Configuration.theme_color %>",
  "theme_color": "<%= Configuration.theme_color %>",
  "display": "standalone",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "icons": [
    <% if (company_logo = Configuration.with_attached_company_logo.company_logo).attached? %>
      {
        "src": "<%= main_app.url_for(company_logo) %>",
        "sizes": "any",
        "type": "<%= company_logo.content_type %>"
      }
    <% else %>
      {
        "src": "<%= asset_path('schematics/logo.svg') %>",
        "sizes": "any",
        "type": "image/svg+xml"
      }
    <% end %>
  ]
}
