- breadcrumb title, new_one_time_passwords_path
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = render Schematics::CardHeading::Component.new(icon: :mobile_screen, title:)
      .col-auto
        = render Schematics::Button::DestroyOtp::Component.new
  .card-body.p-3
    = render Schematics::OneTimePasswordForm::Component.new(resource: @resource)
