.d-flex.justify-content-center.text-white.mb-4.pb-4
  - if setting(:company_logo).attached?
    = image_tag main_app.url_for setting(:company_logo).representation(resize_to_fit: [300, 150])
  - else
    = fa_icon :door_closed, size: "7x"
.card.shadow-sm
  .card-header.p-2
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :unlock, class: "mr-3 ml-3 fa-lg align-middle"
      span.align-middle= title
  .card-body
    = simple_form_for @user, url: password_reset_path(params[:id]), validate: true, defaults: { input_html: { class: "bg-light border-0" } } do |f|
      = f.input :password, required: true
      = f.input :password_confirmation, required: true
      = f.button :button, class: "btn btn-primary btn-sm btn-icon-split mr-2" do
        span.icon= fa_icon :check
        span.text= t('schematics.application.form.buttons.confirm')
      = link_to login_path, class: "btn btn-danger btn-sm btn-icon-split" do
        span.icon= fa_icon :times
        span.text= t('schematics.application.form.buttons.cancel')
