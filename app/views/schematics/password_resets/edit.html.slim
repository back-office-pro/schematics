.d-flex.justify-content-center.text-white.mb-4.pb-4
  = component :attachment, :company_logo, icon: :door_closed
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
    = component :card_heading, icon: :unlock, title:
  .card-body.p-3
    = bootstrap_form_with model: @user, url: password_reset_path(params[:token]) do |form|
      = component 'resource_form/fields/digest', form:, confirm: true
      = component 'button/confirm'
      = component 'button/cancel', path: main_app.login_path
