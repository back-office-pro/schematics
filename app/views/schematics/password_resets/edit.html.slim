.d-flex.justify-content-center.text-white.mb-4.pb-4
  = render Schematics::Attachment::Component.create_company_logo(attachment: setting(:company_logo), icon: :door_closed)
.card.shadow-sm
  .card-header.p-2
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :unlock, class: 'mr-3 ml-3 fa-lg align-middle'
      span.align-middle = title
  .card-body
    = simple_form_for @user, url: password_reset_path(params[:id]), wrapper: :input_group, validate: true do |f|
      = f.input :password, required: true, prepend: fa_icon(:key)
      = f.input :password_confirmation, required: true, prepend: fa_icon(:key)
      = f.button :button, class: 'btn btn-primary btn-sm btn-icon-split mr-2' do
        span.icon = fa_icon :check
        span.text = t('schematics.application.button.confirm')
      = link_to login_path, class: 'btn btn-danger btn-sm btn-icon-split' do
        span.icon = fa_icon :times
        span.text = t('schematics.application.button.cancel')
