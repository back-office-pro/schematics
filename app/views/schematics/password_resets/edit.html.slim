.card.shadow
  .card-header
    h5.m-0.text-primary.font-weight-bold
      = fa_icon :unlock, class: "mr-2"
      | Mot de passe oublié
  .card-body
    = simple_form_for @user, url: password_reset_path(params[:id]), defaults: { input_html: { class: "bg-light border-0" } } do |f|
      = f.input :password, required: true, input_html: { required: true }
      = f.input :password_confirmation, required: true, input_html: { required: true }  
      = f.button :button, class: "btn-primary btn-icon-split mr-2" do
        span.icon= fa_icon :check
        span.text Valider
      = link_to "Annuler", login_path, class: "btn btn-link"
