.d-flex.justify-content-center.text-white.mb-4.pb-4
  = fa_icon :door_closed, size: "7x"
.card.shadow-sm
  .card-header
    h5.m-0.text-primary.text-truncate.font-weight-bold
      = fa_icon :key, class: "mr-2"
      = title
  .card-body
    = form_tag password_resets_path, method: :post do
      .form-group
        = label_tag :email
        = email_field_tag :email, params[:email], required: true, class: "form-control bg-light border-0"
      = button_tag class: "btn btn-primary btn-icon-split mr-2" do
        span.icon= fa_icon :check
        span.text= t('schematics.application.form.buttons.confirm')
      = link_to login_path, class: "btn btn-danger btn-icon-split" do
        span.icon= fa_icon :times
        span.text= t('schematics.application.form.buttons.cancel')
