.d-flex.justify-content-center.text-white.mb-4.pb-4
  = render Schematics::Attachment::Component.company_logo(attachment: settings(:company_logo), icon: :door_closed)
.card.shadow-sm.border-0
  .card-header.border-top-0.border-left-0.border-right-0.border-light.px-2.py-1
    = render Schematics::CardHeading::Component.new(icon: :key, title:)
  .card-body.p-3
    = simple_form_for :user, url: password_resets_path, wrapper: :input_group do |f|
      = f.input :email, prepend: fa_icon(:envelope)
      = render Schematics::Button::Confirm::Component.new
      = render Schematics::Button::Cancel::Component.new(path: login_path)
