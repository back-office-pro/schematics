- breadcrumb record.to_s, main_app.polymorphic_path(record)
- breadcrumb title, new_message_reply_path(record)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = __card_heading(icon: :reply, title:)
  .card-body.p-3
    = __resource_form(resource: @resource, url: message_replies_path(record), cancel_path: record)
