.card.shadow-sm
  .card-header
    ul.nav
      li.nav-item
        h5.m-0.text-primary.text-truncate.font-weight-bold.card-header-title
          = fa_icon :folder_open, class: "mr-2"
          = "#{@resource.parent&.name} > #{@resource.name}"
      li.nav-item.ml-auto
        = link_to new_directory_path, class: "btn btn-primary btn-icon-split mr-2" do
          span.icon= fa_icon :folder
          span.text.d-none.d-lg-inline Ajouter un nouveau dossier
        = link_to new_directory_path, class: "btn btn-primary btn-icon-split" do
          span.icon= fa_icon :file
          span.text.d-none.d-lg-inline Ajouter des fichiers
  .card-body
    .row
      .col.text-center
        = link_to @resource.parent.nil? ? directories_path : @resource.parent do 
          = fa_icon :folder_open, size: '2x', type: :regular
          h6.mt-2 ..
      - @resource.sub_directories.each do |directory|
        = render 'directory', directory: directory
      - @resource.files.each do |file|
        = render 'file', file: file
