- breadcrumb title, polymorphic_path(@resource)
- versions = Schematics::Version.timeline(current_ability, @resource.versions.includes(item: entity.includes))
.card.shadow-sm.border-0
  .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = render Schematics::CardHeading::Component.new(icon: :eye, title:)
      .col-auto
        = render Schematics::Button::GenerateFileInBackground::Component.pdf
        = render Schematics::Button::Edit::Component.new(resource: @resource, compact: false)
        = render Schematics::Button::Duplicate::Component.new(resource: @resource)
        = render Schematics::Button::Destroy::Component.new(resource: @resource, compact: false)
  .card-body.p-3
    = public_send @resource.type,
                  chart_path(@resource),
                  id: @resource.css_id,
                  xtitle: @resource.xtitle,
                  ytitle: @resource.ytitle,
                  suffix: @resource.suffix,
                  nonce: content_security_policy_nonce,
                  download: { filename: @resource.filename },
                  dataset: { borderWidth: @resource.border_width }
- if versions.any?
  .row.justify-content-center.mt-4
    .col-xl-9.col-md-12.position-relative
      ul.timeline.list-unstyled
        - versions.each do |version|
          li
            .timeline-icon.bg-primary
              = fa_icon version.icon, size: '2x', class: 'text-light'
            .card.border-0
              .card-body.p-3
                = render Schematics::VersionPreview::Component.new(version:)
