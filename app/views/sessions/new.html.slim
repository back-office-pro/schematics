.d-flex.justify-content-center.text-white.mb-4.pb-4
  = render Schematics::Attachment::Component.company_logo(attachment: settings(:company_logo), icon: :door_open)
.card.shadow-sm.border-0.animate__animated.animate__zoomIn
  .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
    = render Schematics::CardHeading::Component.new(icon: :right_to_bracket, title:)
  .card-body.p-3
    = simple_form_for ::User.new,
                      as: :session,
                      url: sessions_path,
                      data: { turbo: false, action: 'submit->application#disableWith' } do |form|
      = form.input :email, as: :email, prepend: fa_icon(:envelope)
      = render Schematics::Input::Password::Component.new(form:)
      = form.input :remember_me, as: :boolean
      = render Schematics::Button::Confirm::Component.new
      = link_to t('.password_lost?'), schematics.new_password_reset_path, class: 'btn btn-link btn-sm text-decoration-none'
