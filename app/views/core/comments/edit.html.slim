- breadcrumb record.to_s, record
- breadcrumb title, edit_polymorphic_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = component :card_heading, icon: model_class.entity.icon, title:
      .col-auto
        = component 'button/stale', resource: @resource
  .card-body.p-3
    = component :resource_form, resource: @resource, cancel_path: record
