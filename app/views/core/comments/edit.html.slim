- breadcrumb record.to_s, resource_path(record)
- breadcrumb title, edit_resource_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.p-2
    .row.align-items-center
      .col.text-truncate.px-1
        = __card_heading(icon: model_class.entity.icon, title:)
      .col-auto
        = __button_stale(resource: @resource)
  .card-body.p-3.pt-1
    = __resource_form(resource: @resource, cancel_path: resource_path(record))
