- breadcrumb title, new_polymorphic_path([parent_model_class, model_class], format: nil)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = component :card_heading, icon: model_class.entity.icon, title:
      .col-auto
        = component('button/help', model_class:)
        = component('button/generate_file_in_background', :csv_template)
  .card-body.p-3
    - url = polymorphic_path([parent_model_class, model_class], format: nil)
    = component :resource_form, resource: @resource, url:, cancel_path: parent_model_class
