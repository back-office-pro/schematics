- breadcrumb title, new_import_resource_path(parent_model_class)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.p-2
    .row.align-items-center
      .col.text-truncate.px-1
        = __card_heading(icon: model_class.entity.icon, title:)
      .col-auto
        = __button_help(model_class:)
        = __button_generate_file_in_background(:csv_template)
  .card-body.p-3.pt-1
    - url = import_resource_path(parent_model_class)
    = __resource_form(resource: @resource, url:, attributes:, cancel_path: resources_path(parent_model_class))
