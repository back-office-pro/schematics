- breadcrumb title, polymorphic_path(@resource)
- if @results.empty?
  .card.shadow-sm.mb-3.animate__animated.animate__zoomIn
    .card-header.px-2.py-1
      = render Schematics::CardHeading::Component.new(icon: :magnifying_glass, title:)
    .card-body.p-3
      = render Schematics::EmptyResource::Component.new(suggestions: @suggestions)
- else
  = render Schematics::Viewer::Association::Component.with_collection(@results, collapsed: false, highlight_text: @resource.query)
