.d-flex.justify-content-center.text-white.mb-4.pb-4
  = render Schematics::Attachment::Component.company_logo(icon: :door_open)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
      .row.align-items-center
        .col.text-truncate
          = render Schematics::CardHeading::Component.new(icon: :right_to_bracket, title:)
        .col-auto
          = render Schematics::Button::SsoSignIn::Component.new
          = render Schematics::Button::GoogleSignIn::Component.new
  .card-body.p-3
    = render Schematics::AuthForm::Component.new
