- breadcrumb record.to_s, record
- breadcrumb title, new_polymorphic_path([record, model_class], format: nil)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = __card_heading(icon: model_class.entity.icon, title:)
      .col-auto
        = __button_help(model_class:)
  .card-body.p-3
    = __resource_form(resource: @resource, url: polymorphic_path([record, model_class], format: nil), cancel_path: record)
