- breadcrumb title, polymorphic_path(@resource)
.row.g-3
  - @resources.each do |resource|
    .col-lg-6
      .card.shadow-sm.animate__animated.animate__zoomIn
        .card-header.px-2.py-1
          .row.align-items-center
            .col.text-truncate
              = component :card_heading, icon: parent_model_class.entity.icon, title: resource.to_s
        .card-body.p-0
          = component :resource_details, resource:, model_class: parent_model_class
