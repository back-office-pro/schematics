- breadcrumb title, edit_polymorphic_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn data-controller='nested-form'
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = component :card_heading, icon: :pen_to_square, title:
      .col-auto
        = component('button/help', model_class:)
        = component('schema_editor/button/add_entity')
        = component('button/stale', resource: @resource)
  .card-body.p-3
    = component :schema_editor, resource: @resource
