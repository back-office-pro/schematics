- breadcrumb title, edit_resource_path(@resource)
#selector.card.shadow-sm.animate__animated.animate__zoomIn data-controller='nested-form'
  .card-header.p-2
    .row.align-items-center
      .col.text-truncate.px-1
        = __card_heading(icon: :pen_to_square, title:)
      .col-auto
        = __button_help(model_class:)
        = __schema_editor_button_selector_resource_form
        = __schema_editor_button_selector_schema_editor
        = __schema_editor_button_add_entity
        = __button_stale(resource: @resource)
  .card-body.p-3.pt-1
    = __schema_editor(resource: @resource)
    .resource-form.collapse data-bs-parent='#selector'
      = __resource_form(resource: @resource)
