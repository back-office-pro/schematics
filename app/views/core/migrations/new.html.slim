- breadcrumb title, new_polymorphic_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn {
  data-controller='auto-save nested-form'
  data-auto-save-draft-value=@draft&.to_json
}
  .card-header.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = render Schematics::CardHeading::Component.new(icon: :plus, title:)
      .col-auto
        = render Schematics::Button::Help::Component.new(model_class:)
        = render Schematics::SchemaEditor::Button::AddEntity::Component.new
        = render Schematics::Button::RestoreDraft::Component.new(draft: @draft)
        = render Schematics::Button::Draft::Component.new
  .card-body.p-3
    = render Schematics::SchemaEditor::Component.new(resource: @resource)
