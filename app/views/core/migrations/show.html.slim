- breadcrumb title, resource_path(@resource)
.card.shadow-sm.animate__animated.animate__zoomIn
  .card-header.p-2
    .row.align-items-center
      .col.text-truncate.px-1
        = __card_heading(icon: :eye, title:)
      .col-auto
        = __button_generate_file_in_background(:pdf)
        = __button_emailing(resource: @resource)
        = __button_comment(resource: @resource)
        = __button_edit(resource: @resource, compact: false)
        = __viewer_event_button_group(resource: @resource, compact: false)
  .card-body.p-3.pt-1
    = __viewer_schema(schema: @resource.data)
.row.g-3.mt-0
  .col-xl-9.col-md-12
    = __viewer_specifications(schema: @resource.data)
  .col-xl-3.col-md-12
    = __viewer_migrator(resource: @resource)
= __viewer_comments(resource: @resource)
= __viewer_timeline(resource: @resource)
