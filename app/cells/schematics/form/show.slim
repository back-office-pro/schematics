= simple_form_for model, url: url, validate: true, defaults: { input_html: { class: "bg-light border-0" } } do |f|
  - (attributes - entity.belongs_to_attributes).each do |attribute|
    - case attribute
    - when Schematics::Attributes::Date
      = f.input attribute.name.to_sym, as: :date, html5: true
    - when Schematics::Attributes::String
      = f.input attribute.name.to_sym,
                maxlength: true,
                minlength: true,
                pattern: true,
                wrapper: :input_group,
                prepend: fa_icon(attribute.icon)
    - when Schematics::Attributes::Decimal
      = f.input attribute.name.to_sym,
                min_max: true,
                wrapper: :input_group,
                prepend: attribute.unit || fa_icon(attribute.icon)
    - when Schematics::Attributes::RichText
      = f.input attribute.name.to_sym, as: :rich_text_area
    - when Schematics::Attributes::Enum
      = f.input attribute.name.to_sym,
                as: :radio_buttons,
                collection: attribute.input_collection.map(&:reverse)
    - when Schematics::Attributes::Attachments
      = f.input attribute.name.to_sym,
                as: :file,
                validate: { presence: attribute.required? && new_record? },
                hint: cell('schematics/validators', attribute).(),
                input_html: { multiple: true }
    - when Schematics::Attributes::Attachment
      - attachment = model.send(attribute.name.to_sym)
      - if attachment.attached? && attachment.persisted?
        = f.simple_fields_for :"#{attachment.name}_attachment_attributes" do |fields|
          = fields.hidden_field :id, value: attachment.id
          = fields.input :_destroy, as: :boolean, wrapper_html: { class: "float-right m-0 text-dark" } 
      = f.input attribute.name.to_sym,
                as: :file,
                validate: { presence: attribute.required? && new_record? },
                hint: cell('schematics/validators', attribute).()
    - when Schematics::Attributes::Digest
      = f.input attribute.name.to_sym,
                required: new_record?,
                input_html: { autocomplete: "new-password" },
                prepend: fa_icon(attribute.icon)
      = f.input :"#{attribute.name}_confirmation",
                required: new_record?,
                input_html: { autocomplete: "new-password" },
                prepend: fa_icon(attribute.icon)
    - else
      = f.input attribute.name.to_sym,
                wrapper: :input_group,
                prepend: attribute.try(:unit) || fa_icon(attribute.icon)
  - entity.belongs_to_attributes.each do |attribute|
    = f.association attribute.name.to_sym,
                    prompt: t('schematics.application.form.prompt', model_name: model_class.human_attribute_name(attribute.name).downcase)
  - entity.has_and_belongs_to_many_associations.each do |association|
    = f.association association.name.to_sym, as: :check_boxes
  = f.button :button, class: "btn btn-primary btn-sm btn-icon-split mr-2", disabled: new_record? do
    span.icon= fa_icon :check
    span.text= t('schematics.application.form.buttons.confirm')
  = link_to cancel_path, class: "btn btn-danger btn-sm btn-icon-split" do
    span.icon= fa_icon :times
    span.text= t('schematics.application.form.buttons.cancel')
