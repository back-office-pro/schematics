.card.shadow-sm.mt-4
  a.card-header.p-2 class=('collapsed' if collapsed) href="#collapse-#{random}" data-toggle="collapse" role="button"
    .row.align-items-center
      .col.text-truncate
        h5.m-0.text-primary.text-truncate.font-weight-bold
          = fa_icon icon, class: "mr-3 ml-3 fa-lg align-middle"
          span.align-middle= title
      .col-auto.mr-4
        .badge.badge-light.border.p-2.mr-4= resources.size
  .collapse class=(collapsed ? 'hide' : 'show') id="collapse-#{random}"
    .card-body.p-0
      .table-responsive
        table.table.mb-0.table-striped.table-hover
          thead
            tr
              th.text-nowrap.text-center.align-middle
              - entity.renderable_elements.sort_by(&:weight).each do |field|
                th.text-nowrap.text-center.align-middle
                  = fa_icon field.icon, class: "mr-2 text-dark"
                  = model_class.human_attribute_name(field.name)
          tbody.table-bordered.border-0
            - resources.includes(entity.includes).each do |resource|
              tr data-href=polymorphic_path(resource)
                td.text-nowrap.text-center
                  .btn-group
                    - if can?(:update, resource)
                      = link_to edit_polymorphic_path(resource),
                        class: "btn btn-primary btn-sm",
                        data: { toggle: "tooltip", placement: "top", title: t('schematics.application.viewers.table.edit') } do
                        = fa_icon :edit
                    - if can?(:archive, resource)
                      = link_to fa_icon(:archive),
                        polymorphic_path(resource, action: :archive),
                        method: :delete,
                        class: "btn btn-danger btn-sm",
                        data: { toggle: "tooltip", placement: "top", title: t('schematics.application.viewers.table.archive') }
                - entity.renderable_elements.sort_by(&:weight).each do |field|
                      td.text-nowrap.text-center.align-middle
                        = cell('schematics/resource', resource, field: field).()
