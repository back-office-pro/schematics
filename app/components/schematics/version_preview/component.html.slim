.row data-href=(version_path(@version) if item.present?)
  .col-auto.align-self-center
    = link_to render(Schematics::Attachment::Component.build_avatar(attachment: user.avatar)), user
  .col.text-truncate
    - if item.present?
      = link_to(item, item)
    - else
      .text-muted = @version.reify(dup: true)
    .text-muted = timeago_tag(created_at, force: true)
  .col-auto.align-self-center
    = fa_icon(icon, size: '2x', class: 'fa-fw text-light')
