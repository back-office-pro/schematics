.row {
  data-action=action
  data-application-href-param=href
  role=role
}
  .col-auto.align-self-center
    = render Schematics::Avatar::Component.new(user:)
  .col.text-truncate
    = render Schematics::ResourceLinkTo::Component.new(resource: item)
    .text-body-secondary = version.reify(dup: true).to_s unless item
    .text-body-tertiary data-controller='timeago' datetime=created_at
  .col-auto.align-self-center
    = fa_icon(icon, size: '2x', class: 'fa-fw text-body-tertiary')
