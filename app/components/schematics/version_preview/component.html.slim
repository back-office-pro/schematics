.row data-href=href
  .col-auto.align-self-center
    = render Schematics::Avatar::Component.new(user:)
  .col.text-truncate
    - if item
      = link_to(item.to_s, item, class: 'text-decoration-none')
    - else
      .text-muted = @version.reify(dup: true).to_s
    .text-muted.timeago datetime=created_at
  .col-auto.align-self-center
    = fa_icon(icon, size: '2x', class: 'fa-fw text-light')
