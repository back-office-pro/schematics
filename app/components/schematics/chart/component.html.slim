.col-xl-6.col-md-12.cursor-grab data-id=id
  .card.shadow-sm.animate__animated.animate__zoomIn
    .card-header.px-2.py-1
      = render Schematics::CardHeading::Component.new(icon:, title: @chart)
    .card-body.p-3
      = public_send type,
                    chart_path(@chart, format: :json),
                    id: css_id,
                    xtitle:,
                    ytitle:,
                    suffix:,
                    nonce: content_security_policy_nonce,
                    height: '300px',
                    download: { filename: },
                    dataset: { borderWidth: border_width }
