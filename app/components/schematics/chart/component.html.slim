.cursor-grab class=col_classes data-id=id
  .card.shadow-sm.animate__animated.animate__zoomIn
    .card-header.px-2.py-1
      = component :card_heading, icon:, title: @chart
    .card-body.p-3
      = public_send type,
                    chart_path(@chart, format: :json),
                    id: css_id,
                    xtitle:,
                    ytitle:,
                    suffix:,
                    height: '300px',
                    download: { filename: },
                    dataset: { borderWidth: border_width }
