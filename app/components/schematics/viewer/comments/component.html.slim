#comments.offcanvas.offcanvas-end {
  aria-labelledby='commentsLabel'
  tabindex='-1'
  data-bs-scroll='true'
}
  .offcanvas-header
    = render Schematics::CardHeading::Component.new(icon:, title:)
    = render Schematics::Button::AddComment::Component.new(resource: @resource)
    h5#commentsLabel.offcanvas-title
    button.btn-close.text-reset aria-label='Close' data-bs-dismiss='offcanvas' type='button'
  .offcanvas-body.pt-0
    = render Schematics::CommentPreview::Component.with_collection(comments)
