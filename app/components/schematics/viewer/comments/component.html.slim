#comments.offcanvas.offcanvas-end.body-bg-tertiary data-controller='offcanvas' tabindex='-1' data-bs-scroll='true'
  .offcanvas-header
    = component(:card_heading, icon:, title:)
    = component('button/add', model_class:, resource:)
    button.btn-close.text-reset.ms-2 aria-label='Close' data-bs-dismiss='offcanvas' type='button'
  .offcanvas-body.pt-0
    = turbo_frame_tag 'comments', data: { turbo_action: 'advance' } do
      = component :comment_preview, @comments
      = component 'viewer/pagination', pagy: @pagy
