- events.each do |event|
  = form_for @resource, url: polymorphic_path(@resource, action: :trigger), html: { class: css_class } do |f|
    = f.hidden_field :event, value: event.name
    - if compact?
      = f.button :button, class: 'btn btn-primary btn-sm', data: { toggle: 'tooltip', placement: 'top', title: event.human } do
        = fa_icon event.icon
    - else
      = f.button :button, class: 'btn btn-primary btn-sm btn-icon-split' do
        span.icon = fa_icon event.icon
        span.text.d-none.d-lg-inline = event.human
