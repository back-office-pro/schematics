= link_to url, title: event.human, data:, role: 'button', class: css_classes do
  span.icon = fa_icon event.icon, class: icon_class
  span.icon.d-none = fa_icon :spinner, class: icon_class, animation: 'spin'
  span.text.d-none.d-xxl-inline = event.human unless compact?
  span.text.d-none = t('schematics.application.button.loading') unless compact?
