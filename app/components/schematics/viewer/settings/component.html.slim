.dropdown.position-static data-controller='viewer-settings'
  button#settings-dropdown.btn.btn-sm.dropdown-toggle {
    aria-expanded='false'
    data-bs-toggle='dropdown'
    type='button'
  }
    = fa_icon :ellipsis_vertical
  .dropdown-menu.border-0.shadow-sm.dropdown-menu-start.animate__animated.animate__zoomIn.p-0 {
    aria-labelledby='settings-dropdown'
    data-action='click->viewer-settings#keepOpened:stop'
  }
    h5.dropdown-header.fw-bold
      = t('.title')
    - if can?(:restore, model_class)
      .dropdown-item
        = render Schematics::Filter::Checkbox::Component.new(field: :with_deleted)
    - listable_elements.stable_sort_by(&:weight).each do |field|
      .dropdown-item
        .form-check.form-switch.mb-0 data-action='input->viewer-settings#toggleColumn'
          - preference = "col_#{@entity.table_name}_#{field.name}"
          = check_box 'preferences', preference, { class: 'form-check-input', id: preference, checked: preferences(preference, true) }, '', ''
          = label_tag preference, model_class.human_attribute_name(field.name), class: 'form-check-label float-start', for: preference
