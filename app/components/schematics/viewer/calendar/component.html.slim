.table-responsive
  table.table.mb-0
    = render Schematics::Filter::Component.new(model_class:)
    tbody
      table.table.mb-0.table-striped
        thead
          tr
            - date_range.slice(0, 7).each do |day|
              th.text-center = t('date.day_names')[day.wday]
        tbody class=tbody_css_classes
          - date_range.each_slice(7) do |week|
            tr
              - week.each do |date|
                td class=td_classes_for(date)
                  .text-muted = date.day
                  - resources_for(date).each do |resource|
                    .alert.alert-secondary.text-truncate.mb-1.p-2 data-href=href(resource)
                      = render Schematics::Viewer::ActionButtonGroup::Component.new(resource:)
                      span.ml-2 = resource
