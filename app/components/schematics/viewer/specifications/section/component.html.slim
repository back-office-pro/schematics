li.list-group-item class=@item_class
  - @indent.times do
    = fa_icon @icon, class: 'fa-fw invisible me-2'
  = fa_icon @icon, class: 'fa-fw me-2'
  == interpolate(@element)
= render Schematics::Viewer::Specifications::Options::Component.new(element: @element, indent: @indent.next, icon: :gear) if @options
