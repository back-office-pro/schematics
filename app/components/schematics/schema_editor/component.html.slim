= bootstrap_form_with model: schema, scope: :migration, url:, method: form_method, data: do |form|
  = component('schema_editor/template/entity', form:)
  = component('schema_editor/template/virtual', form:)
  = component('schema_editor/template/trigger', form:)
  = component('schema_editor/template/association/has_and_belongs_to_many', form:)
  = component('schema_editor/template/attribute', attributes_collection, form:)
  = component('schema_editor/template/attribute', :belongs_to_has_one, form:)
  = component('schema_editor/errors', errors:)
  .row.g-3.pb-3#entities data-nested-form-target='targets'
    = form.fields_for :entities, entities do |builder|
      = component 'schema_editor/entity', builder:
  = component 'button/confirm'
  = component 'button/cancel', path: resource
