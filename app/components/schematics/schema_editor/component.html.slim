= simple_form_for ::SchemaDataset.last.data, as: :schema_dataset, url:, method: :post, wrapper:, validate: true, html: { data: } do |form|
  .row.g-3.pb-3
    template#schema-editor-entity data-nested-form-target='templates'
      = form.simple_fields_for :entities, Schematics::Entities::Entity.new, child_index: 'NEW_RECORD' do |builder|
        = render Schematics::SchemaEditor::Entity::Component.new(builder:)
    = form.simple_fields_for :entities, entities do |builder|
      = render Schematics::SchemaEditor::Entity::Component.new(builder:)
  = render Schematics::Button::Confirm::Component.new
  = render Schematics::Button::Cancel::Component.new(path: ::SchemaDataset)
