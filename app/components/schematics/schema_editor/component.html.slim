= form_with model: Schematics::Schema.instance, url: schema_path, method: :patch do |form|
  = render Schematics::SchemaEditor::Tabs::Component.new
  .card.shadow-sm.border-0
    .tab-content.card-body.p-3
      = render Schematics::SchemaEditor::Entity::Component.with_collection(entities, form:)
      = render Schematics::Button::Confirm::Component.new
      = render Schematics::Button::Cancel::Component.new(path: admin_path)
