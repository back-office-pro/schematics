.col-xl-6.col-md-12.schema-editor-trigger
  .card.shadow-sm.border-0
    .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
      .row.align-items-center
        .col.text-truncate
          = render Schematics::CardHeading::Component.new(icon:, title:)
        .col-auto
          = render Schematics::SchemaEditor::Button::Remove::Component.new(wrapper: '.schema-editor-trigger')
    .card-body
      = builder.input :action,
                      as: :select,
                      collection:,
                      include_blank: false,
                      wrapper:,
                      input_html: { data: { controller: 'dropdown' } }
      = builder.input :callback, input_html: { data: }
