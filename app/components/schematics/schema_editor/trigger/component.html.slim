.col-xl-4.col-md-6.schema-editor-trigger
  .card.shadow-sm.border-0.animate__animated.animate__zoomIn
    .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
      = render Schematics::CardHeading::Component.new(icon:, title: t('.title'))
    .card-body
      = @builder.input :action,
                      as: :select,
                      collection:,
                      include_blank: false,
                      input_html: { data: { controller: 'dropdown' } }
      = @builder.input :callback
      = render Schematics::SchemaEditor::Button::Remove::Component.new(wrapper: '.schema-editor-trigger')
