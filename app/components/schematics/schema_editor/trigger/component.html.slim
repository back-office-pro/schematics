.col-xl-6.col-md-12.schema-editor-trigger.cursor-grab
  .card.shadow-sm
    .card-header.px-2.py-1
      .row.align-items-center
        .col.text-truncate
          = render Schematics::CardHeading::Component.new(icon:, title:)
        .col-auto
          = render Schematics::SchemaEditor::Button::Remove::Component.new(wrapper: '.schema-editor-trigger')
    .card-body
      = builder.select :action, collection, {}, { required: true, data: { controller: 'dropdown' } }
      = builder.text_field :callback, data:
