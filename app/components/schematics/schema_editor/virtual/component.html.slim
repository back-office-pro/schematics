.col-xl-2.col-md-4.virtual
  .card.border-0.bg-light.animate__animated.animate__zoomIn
    .card-body
      .text-center.mb-2
        = fa_icon icon, size: '2x', class: 'text-primary'
      = @builder.input :name
      = @builder.input :function
      = link_to_remove_association fa_icon(:trash), @builder, class: 'btn btn-sm btn-danger', 'data-wrapper-class': 'virtual'
      = render Schematics::SchemaEditor::Options::Component.new(builder: @builder)
