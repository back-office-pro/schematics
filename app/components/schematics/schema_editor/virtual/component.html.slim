.col-xl-2.col-md-4.schema-editor-virtual
  .card.border-0.animate__animated.animate__zoomIn
    .card-body
      .text-center.mb-2
        = fa_icon icon, size: '2x', class: 'text-primary'
      = @builder.input :name
      = @builder.input :function
      = render Schematics::SchemaEditor::Button::Remove::Component.new(wrapper: '.schema-editor-virtual')
      = render Schematics::SchemaEditor::Options::Component.new(builder: @builder)
