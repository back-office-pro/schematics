.col-xl-6.col-md-12.schema-editor-virtual
  .card.shadow-sm
    .card-header.px-2.py-1
      .row.align-items-center
        .col.text-truncate
          = render Schematics::CardHeading::Component.new(icon:, title:)
        .col-auto
          = render Schematics::SchemaEditor::Button::Options::Component.new(builder:)
          = render Schematics::SchemaEditor::Button::Remove::Component.new(wrapper: '.schema-editor-virtual')
    .card-body
      = builder.text_field :name,
                           required: true,
                           maxlength: 50,
                           class: 'entity_field_name',
                           data: { controller: 'schema-editor--special-characters' }
      = builder.text_field :function, data:, required: true
      = render Schematics::SchemaEditor::Options::Modal::Component.new(builder:)
