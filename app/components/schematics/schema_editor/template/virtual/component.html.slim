template#schema-editor-virtual data-nested-form-target='templates'
  = @form.simple_fields_for :entities, entity, child_index: 'INDEX' do |entity_builder|
    = entity_builder.simple_fields_for :virtuals, Schematics::Virtuals::Calculation.new(entity:), child_index: 'NEW_RECORD' do |builder|
      = render Schematics::SchemaEditor::Virtual::Component.new(builder:)
