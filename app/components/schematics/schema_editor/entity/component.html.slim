.nested-form-wrapper data-new-record='true'
  = render Schematics::SchemaEditor::Button::Remove::Component.new
  = @builder.input :name
  = @builder.simple_fields_for :options do |options_form|
    = options_form.input :actions,
                          as: :select,
                          collection:,
                          selected: actions,
                          include_hidden: false,
                          input_html: { multiple: true, data: { controller: 'dropdown' } }
    = options_form.input :icon,
                          as: :select,
                          input_html: { data: { controller: 'dropdown', 'dropdown-data-value': icons } }
  - objects.each do |(name, object)|
    .row.g-3 data-controller='nested-form' data-nested-form-wrapper-selector-value='.nested-form-wrapper'
      template data-nested-form-target='template'
        = @builder.simple_fields_for name.pluralize.to_sym, object, child_index: 'NEW_RECORD' do |builder|
          = render Schematics::SchemaEditor.const_get(name.camelize)::Component.new(builder:)
      button.btn.btn-sm.btn-primary.btn-icon-split.me-2 data-action='click->nested-form#add'
        span.icon = fa_icon :plus
        span.text Ajouter un #{name}
      = @builder.simple_fields_for name.pluralize.to_sym do |builder|
        = render Schematics::SchemaEditor.const_get(name.camelize)::Component.new(builder:)
      span data-nested-form-target='target'
