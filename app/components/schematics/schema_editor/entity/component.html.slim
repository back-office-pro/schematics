.col-xl-4.col-md-6.schema-editor-entity
  .card.shadow-sm.border-0
    .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
      .row.align-items-center
        .col.text-truncate
          = render Schematics::CardHeading::Component.new(icon: SchemaDataset.entity.icon, title: t('.title'))
        .col-auto
          = render Schematics::SchemaEditor::Button::AddDropdown::Component.new(builder:)
          = render Schematics::SchemaEditor::Button::Remove::Component.new(wrapper: '.schema-editor-entity')
    .card-body
      = builder.hidden_field :id
      = builder.text_field :name, floating: true, required: true, help: t('.must_be_english')
      = builder.fields_for :options do |options_form|
        = options_form.select :descriptor, allowed_field_names, {}, { data: { controller: 'schema-editor--descriptor-dropdown' } }
        = options_form.select :actions,
                              actions_collection,
                              { selected: actions, include_hidden: false },
                              { multiple: true, data: { controller: 'dropdown' } }
        = options_form.select :icon,
                              [],
                              {},
                              { data: { controller: 'dropdowns--fa-icons-dropdown', 'dropdowns--fa-icons-dropdown-selected-value': icon } }
  .row.g-3.mt-1 id="fields-#{index}" data-nested-form-target='targets'
    = builder.fields_for :attributes do |attributes_builder|
      = render Schematics::SchemaEditor::Attribute::Component.new(builder: attributes_builder)
    = builder.fields_for :virtuals do |virtuals_builder|
      = render Schematics::SchemaEditor::Virtual::Component.new(builder: virtuals_builder)
    = builder.fields_for :triggers do |triggers_builder|
      = render Schematics::SchemaEditor::Trigger::Component.new(builder: triggers_builder)
    = builder.fields_for :has_and_belongs_to_many_associations do |habtm_associations_builder|
      = render Schematics::SchemaEditor::Association::HasAndBelongsToMany::Component.new(builder: habtm_associations_builder)
