.schema-editor-entity
  = render Schematics::SchemaEditor::Button::AddDropdown::Component.new(builder: @builder)
  = render Schematics::SchemaEditor::Button::Remove::Component.new(wrapper: '.schema-editor-entity')
  = @builder.input :name
  = @builder.simple_fields_for :options do |options_form|
    = options_form.input :actions,
                          as: :select,
                          collection:,
                          selected: actions,
                          include_hidden: false,
                          input_html: { multiple: true, data: { controller: 'dropdown' } }
    = options_form.input :icon,
                          as: :select,
                          input_html: { data: { controller: 'dropdown', 'dropdown-data-value': icons } }
  .row.g-3
    = @builder.simple_fields_for :attributes do |builder|
      = render Schematics::SchemaEditor::Attribute::Component.new(builder:)
    template id="schema-editor-attribute-#{@builder.index}" data-nested-form-target='templates'
      = @builder.simple_fields_for :attributes, Schematics::Attributes::Attribute.new, child_index: 'NEW_RECORD' do |builder|
        = render Schematics::SchemaEditor::Attribute::Component.new(builder:)
    = @builder.simple_fields_for :virtuals do |builder|
      = render Schematics::SchemaEditor::Virtual::Component.new(builder:)
    template id="schema-editor-virtual-#{@builder.index}" data-nested-form-target='templates'
      = @builder.simple_fields_for :virtuals, Schematics::Virtuals::Virtual.new, child_index: 'NEW_RECORD' do |builder|
        = render Schematics::SchemaEditor::Virtual::Component.new(builder:)
    = @builder.simple_fields_for :triggers do |builder|
      = render Schematics::SchemaEditor::Trigger::Component.new(builder:)
    template id="schema-editor-trigger-#{@builder.index}" data-nested-form-target='templates'
      = @builder.simple_fields_for :triggers, Schematics::Trigger.new, child_index: 'NEW_RECORD' do |builder|
        = render Schematics::SchemaEditor::Trigger::Component.new(builder:)
