.mb-3 data-controller='nested-form'
  = builder.label name, class: 'form-label'
  template#schema-editor-events-input data-nested-form-target='templates'
    .col-6.schema-editor-events-input
      = builder.fields_for name, Schematics::Options::StateMachineEvent.new do |events_form|
        = events_form.text_field :name, { name: "#{events_form.object_name}[][name]", floating:, required: }
        = events_form.select :icon, [], {}, { data: icon_data, name: "#{events_form.object_name}[][icon]" }
        = events_form.select :color, [], {}, { data: color_data, name: "#{events_form.object_name}[][color]" }
        = events_form.select :from, [], {}, { data:, name: "#{events_form.object_name}[][from][]", floating:, required: }
        = events_form.select :to, [], {}, { data:, name: "#{events_form.object_name}[][to]", floating:, required: }
        = events_form.text_field :callback, { name: "#{events_form.object_name}[][callback]", floating: }
      .btn.btn-sm.btn-danger {
        data-action='click->nested-form#remove:prevent:stop'
        data-nested-form-wrapper-param='.schema-editor-events-input'
        data-controller='tooltip'
        data-bs-toggle='tooltip'
        data-bs-title=t('.remove')
      } = fa_icon :trash
  .row.g-2#schema-editor-events-inputs data-nested-form-target='targets'
    - events.each do |event|
      .col-6.schema-editor-events-input
        = builder.fields_for name, event do |events_form|
          = events_form.text_field :name, { name: "#{events_form.object_name}[][name]", floating:, required: }
          = events_form.select :icon, [], {}, { data: icon_data(event.icon), name: "#{events_form.object_name}[][icon]" }
          = events_form.select :color, [], {}, { data: color_data(event.color), name: "#{events_form.object_name}[][color]" }
          - Array(event.from).each do |value|
            = events_form.select :from, values, { selected: value }, { data:, name: "#{events_form.object_name}[][from][]", floating:, required: }
          = events_form.select :to, values, {}, { data:, name: "#{events_form.object_name}[][to]", floating:, required: }
          = events_form.text_field :callback, { name: "#{events_form.object_name}[][callback]", floating: }
        .btn.btn-sm.btn-danger {
          data-action='click->nested-form#remove:prevent:stop'
          data-nested-form-wrapper-param='.schema-editor-events-input'
          data-controller='tooltip'
          data-bs-toggle='tooltip'
          data-bs-title=t('.remove')
        } = fa_icon :trash
  .btn.btn-sm.btn-primary {
    data-action='click->nested-form#add:prevent'
    data-nested-form-template-id-param='schema-editor-events-input'
    data-nested-form-target-id-param='schema-editor-events-inputs'
    data-controller='tooltip'
    data-bs-toggle='tooltip'
    data-bs-title=t('.add')
  } = fa_icon :plus
