.w-100 data-controller='nested-form'
  template#schema-editor-events-input data-nested-form-target='templates'
    .schema-editor-events-input
      = builder.simple_fields_for :events, Schematics::Attributes::StateMachineEvent.new do |events_form|
        = events_form.input :name, input_html: { name: "#{events_form.object_name}[][name]" }
        = events_form.input :icon, as: :select, required: false, wrapper:, input_html: { data:, name: "#{events_form.object_name}[][icon]" }
        = events_form.input :from, input_html: { name: "#{events_form.object_name}[][from][]" }
        = events_form.input :to, input_html: { name: "#{events_form.object_name}[][to]" }
        = events_form.input :callback, required: false, input_html: { name: "#{events_form.object_name}[][callback]" }
      .btn.btn-sm.btn-danger {
        data-action='click->nested-form#remove:prevent:stop'
        data-nested-form-wrapper-param='.schema-editor-events-input'
        data-controller='tooltip'
        data-bs-toggle='tooltip'
        data-bs-title=t('.remove')
      } = fa_icon :trash
  #schema-editor-events-inputs data-nested-form-target='targets'
    - events.each do |event|
      .schema-editor-events-input
        = builder.simple_fields_for :events, event do |events_form|
          = events_form.input :name, input_html: { value: event.name, name: "#{events_form.object_name}[][name]" }
          = events_form.input :icon,
                              as: :select,
                              required: false,
                              wrapper:,
                              input_html: { data: data(event.icon), name: "#{events_form.object_name}[][icon]" }
          - Array(event.from).each do |value|
            = events_form.input :from, input_html: { value:, name: "#{events_form.object_name}[][from][]" }
          = events_form.input :to, input_html: { value: event.to, name: "#{events_form.object_name}[][to]" }
          = events_form.input :callback, required: false, input_html: { value: event.callback, name: "#{events_form.object_name}[][callback]" }
        .btn.btn-sm.btn-danger {
          data-action='click->nested-form#remove:prevent:stop'
          data-nested-form-wrapper-param='.schema-editor-events-input'
          data-controller='tooltip'
          data-bs-toggle='tooltip'
          data-bs-title=t('.remove')
        } = fa_icon :trash
  .btn.btn-sm.btn-primary {
    data-action='click->nested-form#add:prevent'
    data-nested-form-template-id-param='schema-editor-events-input'
    data-nested-form-target-id-param='schema-editor-events-inputs'
    data-controller='tooltip'
    data-bs-toggle='tooltip'
    data-bs-title=t('.add')
  } = fa_icon :plus
