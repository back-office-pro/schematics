.modal.fade {
  id=target
  data-controller='modal'
  aria-hidden='true'
  aria-labelledby="#{target}-label"
  tabindex='-1'
}
  .modal-dialog.modal-dialog-centered
    .modal-content.border-0.shadow-sm
      .modal-header
        = render Schematics::CardHeading::Component.new(icon:, title:)
        button.btn-close aria-label='Close' data-bs-dismiss='modal' type='button'
      .modal-body
        = builder.fields_for :options do |options_form|
          - available_options.each do |option|
            - case option.input_type
            - when :boolean
              = options_form.check_box option.name, { switch: true }, 'true', 'false'
            - when :string
              = options_form.text_field option.name
            - when :integer
              = options_form.number_field option.name
            - when :select
              = options_form.select option.name, option.collection
            - when :array
              = render Schematics::Input::Array::Component.new(builder: options_form, object_name: options_form.object_name, attribute_name: "options[#{option.name}", merged_input_options: {})
            - when :events
              = render Schematics::SchemaEditor::Options::Events::Component.new(builder: options_form)
