.col-xl-6.col-md-12.schema-editor-habtm-association
  .card.shadow-sm
    .card-header.px-2.py-1
      .row.align-items-center
        .col.text-truncate
          = render Schematics::CardHeading::Component.new(icon:, title:)
        .col-auto
          = render Schematics::SchemaEditor::Button::Options::Component.new(builder:)
          = render Schematics::SchemaEditor::Button::Remove::Component.new(wrapper: '.schema-editor-habtm-association')
    .card-body
      = builder.select :name, allowed_names, {}, { required: true, data: { controller: 'dropdown' } }
      = builder.select :type, collection, { required: true }, { required: true, data: { controller: 'dropdown' } }
      = render Schematics::SchemaEditor::Options::Modal::Component.new(builder:)
