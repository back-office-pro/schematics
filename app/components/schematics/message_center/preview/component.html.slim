.row data-href=href
  .col-auto.align-self-center
    = render Schematics::Avatar::Component.new(user: @message.author)
  .col.text-truncate
    div class=css_class = @message.subject
    .text-muted
      span = @message.author.full_name
      span.mx-1 -
      span.timeago datetime=@message.created_at
