.row {
  data-action='click->application#visit'
  data-application-href-param=href
  role='button'
}
  .col-auto.align-self-center
    = render Schematics::Avatar::Component.new(user: @message.author)
  .col.text-truncate
    div class=css_class = @message.subject
    .text-muted
      span = @message.author
      span.mx-1 -
      span data-controller='timeago' datetime=@message.created_at
