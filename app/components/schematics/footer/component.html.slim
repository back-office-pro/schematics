footer.py-3.border-top
  .row.mx-2.text-secondary
    .col
      | &copy; #{year} #{config(:company_name)}
    .col.text-end.text-nowrap
      - if current_version
        = fa_icon icon, class: 'text-primary me-2'
        = t('.version', current_version:)
      = fa_icon :rocket, class: 'text-primary mx-2'
      = t('.powered_by')
      = link_to 'https://www.back-office.pro', class: 'ms-1' do
        = image_tag 'schematics/logo.svg'
