li.nav-item.dropdown.d-flex.align-items-center.px-3.border-start.border-light data-controller='notification-center'
  a#notifications-dropdown.nav-link.dropdown-toggle {
    aria-expanded='false'
    data-bs-toggle='dropdown'
    href='#'
    role='button'
    data-action='click->notification-center#readNotifications'
  }
    .position-relative
      = fa_icon :bell,
                data: { 'notification-center-target': 'icon' },
                class: icon_class
      - unless unread_count.zero?
        .badge.bg-danger.rounded-pill.position-absolute.top-0.start-100.translate-middle.animate__animated.animate__zoomIn {
          data-notification-center-target='badge'
        }
          = display_unread_count
  .dropdown-menu.border-0.shadow-sm.dropdown-menu-end.animate__animated.animate__zoomIn.p-0.mt-2 {
    aria-labelledby='notifications-dropdown'
  }
    h5.dropdown-header.fw-bold
      = t('.title')
    .pre-scrollable.overflow-scroll
      - versions.each do |version|
        .dropdown-item
          = render Schematics::VersionPreview::Component.new(version:)
    .dropdown-divider.m-0
    = link_to t('.show_all'), versions_path, class: 'dropdown-item text-muted text-center small p-2'
