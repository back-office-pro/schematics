.row.justify-content-center
  .col-xl-9.col-md-12
    ul.timeline.list-unstyled
      - @versions.each do |version|
        li
          .timeline-icon.bg-primary.border.shadow-sm
            = link_to fa_icon(version.icon, size: "2x"), version.model_class, class: "text-light"
          .card.shadow-sm
            .card-body data-target=("#diffModal-#{version.id}" if version.event == "update")
              = render Schematics::Timeline::Difference::Component.new(version: version) if version.event == "update"
              = render Schematics::Timeline::Version::Component.new(version: version)
