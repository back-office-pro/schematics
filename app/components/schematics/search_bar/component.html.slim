= form_for ::Search.new, html: { class: 'd-flex pe-3' } do |f|
  .position-relative.d-flex data-controller='searchBar' data-searchBar-highlight='false'
    = f.search_field :query,
                      required: true,
                      minlength: 3,
                      placeholder: t('.placeholder'),
                      class: 'search form-control border-0 bg-transparent',
                      autocomplete: 'off',
                      spellcheck: false,
                      data: { 'searchBar-target': 'input', action: }
    ul.list-group.list-group-hover.list-group-striped.shadow-sm.typeahead-results.position-absolute.top-100.w-100.z-index-3 {
      data-searchBar-target='results'
    }
    ul.list-group.list-group-hover.list-group-striped.shadow-sm.typeahead-results.position-absolute.top-100.w-100.z-index-3.d-none {
      data-searchBar-target='history'
    }
      - history.each do |query|
        li.list-group-item.p-2.border-0.text-start.text-truncate {
          data-action='mousedown->searchBar#selectItem'
          data-url=search_path(query)
          role='button'
        }
          = fa_icon :history, class: 'text-secondary fa-fw me-2'
          = query
  = f.button class: 'btn nav-link p-0' do
    span.icon = fa_icon :search, class: 'fa-lg'
    span.icon.d-none = fa_icon :spinner, animation: 'spin'
