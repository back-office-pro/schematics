thead
  tr
    th.text-nowrap.text-center.pb-0
      = t('.archives')
    - entity.listable_elements.stable_sort_by(&:weight).each do |field|
        th.text-nowrap.text-center.pb-0
          = render Schematics::SortLink::Component.new(field: field, model_class: @model_class)
  tr.filters
    th.text-nowrap.align-middle.px-0.py-1
      = render Schematics::Filter::Checkbox::Component.new(field: :with_deleted)
    - entity.listable_elements.stable_sort_by(&:weight).each do |field|
        th.align-middle.text-center.px-0.py-1
          = render Schematics::Filter::Component.create(field: field, model_class: @model_class)
