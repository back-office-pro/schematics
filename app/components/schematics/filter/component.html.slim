thead.border-bottom.border-light
  tr
    th.align-top rowspan='2'
      = render Schematics::Viewer::Settings::Component.new(entity: entity)
    - entity.listable_elements.stable_sort_by(&:weight).each do |field|
        th.text-nowrap.text-center.pb-0.animate__animated.animate__slideInDown class=column_css_class(field)
          = render Schematics::SortLink::Component.new(field: field, model_class: @model_class)
  tr
    - entity.listable_elements.stable_sort_by(&:weight).each do |field|
        td.align-middle.text-center.p-0.animate__animated.animate__slideInDown class=column_css_class(field)
          = render Schematics::Filter::Component.create(field: field, model_class: @model_class)
