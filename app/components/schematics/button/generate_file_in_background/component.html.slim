.dropdown.d-inline-block {
    data-controller='generateFileInBackground'
    data-generateFileInBackground-content-type=@content_type
}
  button#generate-file-in-background-button.btn.btn-sm.btn-icon-split {
    data-generateFileInBackground-target='button'
    data-action=action
    data-bs-toggle=toggle
    aria-expanded='false'
  }
    span.icon = fa_icon @icon
    span.icon.d-none = fa_icon :spinner, animation: 'spin'
    span.text.d-none.d-lg-inline = t(".#{@text}")
    span.text.d-none data-generateFileInBackground-target='loading' = t('.loading')
  .dropdown-menu.w-100.border-0.shadow-sm.animate__animated.animate__zoomIn.mt-0 {
    aria-labelledby='generate-file-in-background-button'
  }
    .dropdown-item data-action='click->generateFileInBackground#run' role='button'
      = fa_icon :table, class: 'fa-fw me-3'
      = t('.current_page')
    .dropdown-item data-action='click->generateFileInBackground#run' data-all-pages='true' role='button'
      = fa_icon :file_export, class: 'fa-fw me-3'
      = t('.all_pages')
