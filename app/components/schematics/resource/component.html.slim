- case @field
- when Schematics::Associations::Association, Schematics::Attributes::Association
  - if value.present?
    - if value.deleted?
      .text-muted
        = fa_icon :archive, class: 'mr-2'
        = value
    - else
      = link_to(value, value)
- when Schematics::Attributes::Address
  = render Schematics::GoogleMap::Component.new(address: value)
- when Schematics::Attributes::Attachments
  = render Schematics::Viewer::Association::Component.new(resources: value, collapsed: true)
- when Schematics::Attributes::Attachment
  - if value.attached?
    - if editable?
      = form_for @resource do |f|
        = f.fields_for :"#{value.name}_attachment_attributes" do |fields|
          = fields.hidden_field :id, value: value.id
          = fields.hidden_field :_destroy, value: true
        = f.button :button,
                    class: 'btn btn-danger btn-sm float-right',
                    data: confirm_data.merge({ toggle: 'tooltip', placement: 'left', title: t('schematics.application.button.destroy') }) do
                      = fa_icon(:trash)
    - if value.representable?
      = render Schematics::Attachment::Component.new(attachment: value)
    - else
      = link_to value.filename, value
- when Schematics::Attributes::Boolean, Schematics::Virtuals::Comparison
  - case value
  - when StandardError
    = @field.format(value)
  - when TrueClass
    = fa_icon(:check, class: 'text-success')
  - when FalseClass
    = fa_icon(:times, class: 'text-danger')
- when Schematics::Attributes::RichText
  == value
- when Schematics::Attributes::Country
  - if editable?
    = best_in_place @resource,
                    @field.column_name.to_sym,
                    as: @field.input_type,
                    inner_class: 'form-control border-0 bg-light',
                    collection: @field.input_collection,
                    display_with: ->(value) { tag.span(class: "flag-icon flag-icon-#{value.downcase}") }
  - else
    = tag.span(class: "flag-icon flag-icon-#{value.downcase}")
- when editable? && Schematics::Behaviours::Editable
  = best_in_place @resource,
                  @field.column_name.to_sym,
                  as: @field.input_type,
                  inner_class: 'form-control border-0 bg-light',
                  collection: @field.try(:input_collection),
                  display_with: (->(value) { @field.format(value) } unless @field.is_a?(Schematics::Attributes::Association))
- when Schematics::Behaviours::Searchable
  = highlight @field.format(value), params[:query]
- else
  = @field.format(value)
