head
  meta charset='utf-8'
  meta name='viewport' content='width=device-width,initial-scale=1'
  meta name='apple-mobile-web-app-capable' content='yes'
  meta name='theme-color' content=theme_color
  meta name='view-transition' content='same-origin'
  meta name='turbo-prefetch' content='true'
  = turbo_refreshes_with method: :replace, scroll: :reset
  = turbo_exempts_page_from_preview_tag
  = content_for :head
  title #{company_name} - #{title}
  = csrf_meta_tags
  = csp_meta_tag
  = __application_stylesheet_link
  = __favicon
  = stylesheet_link_tag 'schematics/application', media: 'all', 'data-turbo-track': 'reload'
  = __javascript_importmap
  = javascript_include_tag 'pagy.min', nonce: true
  = javascript_include_tag 'https://www.gstatic.com/charts/loader.js', nonce: true
  = __google_map_include_tag
  = __theme_custom_stylesheet
  = __rouge_theme_stylesheet
  = __inline_javascript
  link rel='manifest' href='/manifest.json' crossorigin='use-credentials'
