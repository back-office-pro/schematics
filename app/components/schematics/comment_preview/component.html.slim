.card.shadow-sm.border-0.animate__animated.animate__zoomIn.mb-3
  .card-header.border-top-0.border-start-0.border-end-0.px-2.py-1
    .row.align-items-center
      .col.text-truncate
        = render Schematics::CardHeading::Component.new(icon: :user, title: author)
      .col-auto
        = render Schematics::Button::Edit::Component.new(resource: @comment)
        = render Schematics::Button::Destroy::Component.new(resource: @comment)
  .card-body.p-3
    == content
