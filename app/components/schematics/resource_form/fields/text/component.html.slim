- if translated?
  - available_locales.each do |locale|
    = form.text_area :"#{name}_#{locale}",
                      label: i18n_label(locale),
                      prepend:,
                      hide_label:,
                      required:,
                      control_class:,
                      data:
- else
  = form.text_area name.to_sym, prepend:, hide_label:, required:, control_class:, data:
