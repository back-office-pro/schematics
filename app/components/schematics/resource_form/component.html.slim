= bootstrap_form_with model: resource, url:, data:, layout: do |form|
  = form.hidden_field :lock_version
  - attributes.stable_sort_by(&:weight).each do |field|
    = turbo_frame_tag dom_id(resource, field.name) do
      - case field
      - when Schematics::Associations::HasAndBelongsToMany
        = render Schematics::ResourceForm::Fields::HasAndBelongsToMany::Component.new(form:, field:)
      - when Schematics::Attributes::BelongsTo
        = render Schematics::ResourceForm::Fields::BelongsTo::Component.new(form:, field:)
      - when Schematics::Attributes::Datetime
        = render Schematics::ResourceForm::Fields::Datetime::Component.new(form:, field:)
      - when Schematics::Attributes::Date
        = render Schematics::ResourceForm::Fields::Date::Component.new(form:, field:)
      - when Schematics::Attributes::Array
        = render Schematics::ResourceForm::Fields::Array::Component.new(form:, field:)
      - when Schematics::Attributes::Address
        = render Schematics::ResourceForm::Fields::Address::Component.new(form:, field:)
      - when Schematics::Attributes::Email
        = render Schematics::ResourceForm::Fields::Email::Component.new(form:, field:)
      - when Schematics::Attributes::Url
        = render Schematics::ResourceForm::Fields::Url::Component.new(form:, field:)
      - when Schematics::Attributes::Phone
        = render Schematics::ResourceForm::Fields::Phone::Component.new(form:, field:)
      - when Schematics::Attributes::Color
        = render Schematics::ResourceForm::Fields::Color::Component.new(form:, field:)
      - when Schematics::Attributes::ModelField
        = render Schematics::ResourceForm::Fields::ModelField::Component.new(form:, field:)
      - when Schematics::Behaviours::Enumerable
        = render Schematics::ResourceForm::Fields::Enumerable::Component.new(form:, field:)
      - when Schematics::Attributes::String, Schematics::Attributes::Jsonb
        = render Schematics::ResourceForm::Fields::String::Component.new(form:, field:)
      - when Schematics::Attributes::Text
        = render Schematics::ResourceForm::Fields::Text::Component.new(form:, field:)
      - when Schematics::Attributes::Rating
        = render Schematics::ResourceForm::Fields::Rating::Component.new(form:, field:)
      - when Schematics::Attributes::RichText
        = render Schematics::ResourceForm::Fields::RichText::Component.new(form:, field:)
      - when Schematics::Attributes::Attachments 
        = render Schematics::ResourceForm::Fields::Attachments::Component.new(form:, field:)
      - when Schematics::Attributes::Attachment
        = render Schematics::ResourceForm::Fields::Attachment::Component.new(form:, field:)
      - when Schematics::Attributes::Digest
        = render Schematics::ResourceForm::Fields::Digest::Component.new(form:, field:, autocomplete: false)
      - when Schematics::Attributes::Boolean
        = render Schematics::ResourceForm::Fields::Boolean::Component.new(form:, field:)
      - when Schematics::Behaviours::Numerable
        = render Schematics::ResourceForm::Fields::Numerable::Component.new(form:, field:)
      = render Schematics::Button::Confirm::Component.new(compact: true) if turbo?
      = render Schematics::Button::Cancel::Component.new(path: cancel_path, compact: true) if turbo?
  = render Schematics::Button::Confirm::Component.new
  = render Schematics::Button::Cancel::Component.new(path: cancel_path)
