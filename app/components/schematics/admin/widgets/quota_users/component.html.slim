.col-xl-3.col-md-6
  .card.animate__animated.animate__zoomIn
    .card-body.p-3
      .row.g-0.align-items-center
        .col.text-center.p-4
          = link_to users_path, class: 'text-decoration-none' do
            = fa_icon icon, size: '3x', class: 'd-inline-block'
            h5.my-4 = title
            .progress.fs-6.my-2 role='progressbar' aria-valuenow=users_size aria-valuemin='0' aria-valuemax=quota_users
              .progress-bar style="width: #{quota_users_percentage}%"
                | #{users_size} / #{quota_users}
