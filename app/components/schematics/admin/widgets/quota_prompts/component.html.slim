.col-xl-3.col-md-6
  .card.animate__animated.animate__zoomIn
    .card-body.p-3
      .row.g-0.align-items-center
        .col.text-center.p-4
          = fa_icon icon, size: '3x', class: 'd-inline-block text-primary'
          h5.text-primary.my-4 = title
          .progress.fs-6 role='progressbar' aria-valuenow=prompts_count aria-valuemin='0' aria-valuemax=quota_prompts
            .progress-bar class=background_css_class style="width: #{percentage}%"
              = number_to_percentage(percentage, precision: 0)
