.col-xl-3.col-md-6
  .card.animate__animated.animate__zoomIn
    .card-body.p-3
      .row.g-0.align-items-center
        .col.text-center.p-4
          = fa_icon icon, size: '3x', class: 'd-inline-block text-primary'
          h5.text-primary.my-4 = title
          .progress.fs-6 role='progressbar' aria-valuenow=entities_size aria-valuemin='0' aria-valuemax=quota_entities
            .progress-bar style="width: #{percentage}%"
              | #{entities_size} / #{quota_entities}
