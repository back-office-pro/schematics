#!/usr/bin/env bash
# remove current dummy
rm -rf ./test/dummy
cd ..
# generate new dummy
rails new dummy \
    --database postgresql \
    --skip-keeps \
    --skip-action-cable \
    --skip-bundle \
    --skip-webpack-install \
    --skip-listen \
    --skip-bootsnap \
    --dummy-app=true \
    --template ./schematics/template.rb
# move dummy in /test directory
mkdir ./schematics/test/dummy
mv ./dummy/* ./schematics/test/dummy
rm -rf ./dummy
cd ./schematics
# clean dummy
rm -rf ./test/dummy/README.md \
       ./test/dummy/public/robots.txt \
       ./test/dummy/vendor
