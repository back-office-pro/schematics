#!/usr/bin/env ruby

# Copyright © 2025 Dev & Software. All rights reserved.
# frozen_string_literal: true

require 'optparse'
require_relative '../lib/generators/app/app_generator'

app_name = 'spec/demo'
log_name = 'log/demo'
options = {}

OptionParser
  .new do |opts|
    opts.on('--name', '--name=NAME', 'Application name') { app_name = log_name = it }
    opts.on('--container', 'Run into docker') { options[:container] = true }
    opts.on('--destroy', 'Destroy application') do
      options[:behavior] = :revoke
      printf "\e[31mAre you sure? Press 'y' to continue: \e[0m"
      exit unless $stdin.gets.chomp == 'y'
    end
  end.parse!

if ENV['CI'].blank?
  $stdout.reopen("#{log_name}.log", 'w')
  $stdout.sync = true
  $stderr.reopen($stdout)
end

AppGenerator
  .new([app_name], **options)
  .invoke_all

$stdout = STDOUT
$stderr = STDERR
