#!/usr/bin/env bash

if [ -z $1 ]
then
    app_name="test/dummy"
    disable=""
    dummy_app="true"
    rm -rf ./test/dummy
else
    app_name=$1
    disable="-no"
    dummy_app="false"
fi

rails new $app_name \
    --database postgresql \
    --skip-keeps \
    --skip-action-cable \
    --skip-bundle \
    --skip-javascript \
    --template template.rb \
    -$disable-skip-listen \
    -$disable-skip-bootsnap \
    --dummy-app=$dummy_app
