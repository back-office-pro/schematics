#!/usr/bin/env ruby

# frozen_string_literal: true

require 'optparse'
require_relative '../lib/generators/app/app_generator'

app_name = ARGV.first || 'spec/dummy'
log_name = ARGV.first || 'log/dummy'
options = {}

$stdout.reopen("#{log_name}.log", 'w')
$stdout.sync = true
$stderr.reopen($stdout)

OptionParser
  .new { _1.on('--container') { options[:container] = true } }
  .parse!

AppGenerator
  .new([app_name], **options)
  .invoke_all

$stdout = STDOUT
$stderr = STDERR
