#!/usr/bin/env bash

if [ -z $1 ]
then
    rm -rf spec/dummy
    time rails new spec/dummy \
                   --database postgresql \
                   --skip-test \
                   --template template.rb \
                   --dummy-app=true \
                   &> log/build.log
else
    rails new $1 --database postgresql --skip-test --template template.rb &> log/$1.log
fi
