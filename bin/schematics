#!/usr/bin/env bash

if [ -z $1 ]
then
    app_name="spec/dummy"
    disable=""
    dummy_app="true"
    rm -rf ./spec/dummy
else
    app_name=$1
    disable="-no"
    dummy_app="false"
fi

rails new $app_name \
    --database postgresql \
    --skip-keeps \
    --skip-action-cable \
    --template template.rb \
    -$disable-skip-listen \
    -$disable-skip-bootsnap \
    -$disable-skip-spring \
    --dummy-app=$dummy_app \
    > log/build.log
