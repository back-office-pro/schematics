#!/usr/bin/env bash

if [ -z $1 ]
then
    app_name="spec/dummy"
    dummy_app="true"
else
    app_name=$1
    dummy_app="false"
fi

rm -rf $app_name
time rails new $app_name \
    --database postgresql \
    --skip-keeps \
    --skip-action-cable \
    --skip-listen \
    --skip-spring \
    --skip-test-unit \
    --template template.rb \
    --dummy-app=$dummy_app \
    &> log/build.log
