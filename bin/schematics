#!/usr/bin/env bash

if [ -z $1 ]
then
    app_name="spec/dummy"
    dummy_app="true"
    rm -rf $app_name
else
    app_name=$1
    dummy_app="false"
fi

time rails new $app_name \
               --database postgresql \
               --skip-test \
               --template template.rb \
               --dummy-app=$dummy_app \
               &> log/build.log
