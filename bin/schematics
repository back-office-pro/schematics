#!/usr/bin/env ruby

# frozen_string_literal: true

require 'fileutils'
require 'pg'
require 'active_support/core_ext/string/filters'

app_name = ARGV.first || 'spec/dummy'

begin
  PG
    .connect
    .exec("CREATE USER #{app_name} CREATEDB")
rescue PG::Error
  nil
end

FileUtils.rm_rf app_name

system <<~SHELL.squish
  time rails new #{app_name}
                 --database postgresql
                 --skip-test
                 --template template.rb
                 &> log/#{app_name}.log
SHELL
