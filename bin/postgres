#!/bin/bash -e


DB_HOST=$(echo "${DATABASE_URL#*@}" | cut -d/ -f1 | cut -d: -f1)
DB_USER=$(echo "${DATABASE_URL#*://}" | cut -d@ -f1 | cut -d: -f1)

createdb -h ${DB_HOST} -U ${DB_USER} ${RAILS_ENV}
pgloader --with "preserve index names" sqlite:///back-office/storage/${RAILS_ENV}.sqlite3 ${DATABASE_URL}/${RAILS_ENV}
