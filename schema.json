{
    "user": {
        "descriptor": "full_name",
        "virtuals": [
            {
                "name": "full_name",
                "function": "$last_name $first_name"
            }
        ],
        "attributes": [
            {
                "name": "email",
                "type": "string",
                "options": {
                    "unique": true,
                    "email": true
                }
            },
            {
                "name": "password",
                "type": "digest", 
                "options": {
                    "min": 6
                }
            },
            {
                "name": "auth_token",
                "type": "token",
                "options": {
                    "unique": true
                }
            },
            {
                "name": "password_reset_token",
                "type": "token",
                "options": {
                    "unique": true
                }
            },
            {
                "name": "first_name",
                "type": "string",
                "options": {
                    "required": true
                }
            },
            {
                "name": "last_name",
                "type": "string",
                "options": {
                    "required": true
                }
            }
        ]
    },
    "message": {
        "descriptor": "subject",
        "attributes": [
            {
                "name": "subject",
                "type": "string",
                "options": {
                    "required": true
                }
            },
            {
                "name": "content",
                "type": "rich_text",
                "options": {
                    "required": true
                }
            },
            {
                "name": "author",
                "type": "belongs_to",
                "options": {
                    "required": true,
                    "type": "user",
                    "inverse": {
                        "name": "sent_messages",
                        "type": "has_many"
                    }
                }
            },
            {
                "name": "recipient",
                "type": "belongs_to",
                "options": {
                    "required": true,
                    "type": "user",
                    "inverse": {
                        "name": "received_messages",
                        "type": "has_many"
                    }
                }
            }
        ]
    },
    "directory": {
        "descriptor": "name",
        "attributes": [
            {
                "name": "name",
                "type": "string",
                "options": {
                    "unique": true
                }
            },
            {
                "name": "parent",
                "type": "belongs_to",
                "options": {
                    "type": "directory",
                    "inverse": {
                        "name": "sub_directories",
                        "type": "has_many"
                    }
                }
            },
            {
                "name": "files",
                "type": "attachments"
            }
        ]
    },
    "client": {
        "descriptor": "full_name",
        "virtuals": [
            {
                "name": "full_name",
                "function": "$first_name $last_name"
            }
        ],
        "attributes": [
            {
                "name": "first_name",
                "type": "string",
                "options": {
                    "required": true
                }
            },
            {
                "name": "last_name",
                "type": "string",
                "options": {
                    "required": true
                }
            }
        ]
    },
    "sub_category": {
        "descriptor": "designation",
        "attributes": [
            {
                "name": "designation",
                "type": "string",
                "options": {
                    "unique": true
                }
            },
            {
                "name": "category",
                "type": "belongs_to",
                "options": {
                    "required": true,
                    "inverse": {
                        "type": "has_many"
                    }
                }
            }
        ]
    },
    "category": {
        "descriptor": "designation",
        "attributes": [
            {
                "name": "designation",
                "type": "string",
                "options": {
                    "unique": true,
                    "required": true
                }
            }
        ]
    },
    "product": {
        "descriptor": "reference",
        "virtuals": [
            {
                "name": "tax_inclusive_price",
                "function": "$price * (1 + $vat / 100)",
                "options": {
                    "scale": 2,
                    "unit": "€"
                }
            },
            {
                "name": "reference",
                "function": "ref-$id-$sub_category.id"
            }
        ],
        "attributes": [
            {
                "name": "designation",
                "type": "string",
                "options": {
                    "unique": true,
                    "limit": 100
                }
            },
            {
                "name": "description",
                "type": "string"
            },
            {
                "name": "price",
                "type": "decimal",
                "options": {
                    "precision": 5,
                    "scale": 2,
                    "unit": "€"
                }
            },
            {
                "name": "vat",
                "type": "float",
                "options": {
                    "default": 19.6,
                    "unit": "%"
                }
            },
            {
                "name": "in_stock",
                "type": "boolean",
                "options": {
                    "default": false
                }
            },
            {
                "name": "logo",
                "type": "attachment"
            },
            {
                "name": "state",
                "type": "enum",
                "options": [
                    "available",
                    "not_available",
                    "available_soon"
                ]
            },
            {
                "name": "sub_category",
                "type": "belongs_to",
                "options": {
                    "required": true,
                    "inverse": {
                        "type": "has_many"
                    }
                }
            }
        ]
    }
}