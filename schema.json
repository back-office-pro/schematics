{
    "user": {
        "descriptor": "email",
        "attributes": [
            {
                "name": "email",
                "type": "string",
                "options": {
                    "unique": true
                }
            }
        ]
    },
    "message": {
        "descriptor": "subject",
        "attributes": [
            {
                "name": "subject",
                "type": "string",
                "options": {
                    "required": true
                }
            },
            {
                "name": "content",
                "type": "rich_text",
                "options": {
                    "required": true
                }
            },
            {
                "name": "author",
                "type": "belongs_to",
                "options": {
                    "required": true,
                    "type": "user",
                    "inverse": {
                        "name": "sent_messages",
                        "type": "has_many"
                    }
                }
            },
            {
                "name": "recipient",
                "type": "belongs_to",
                "options": {
                    "required": true,
                    "type": "user",
                    "inverse": {
                        "name": "received_messages",
                        "type": "has_many"
                    }
                }
            }
        ]
    },
    "directory": {
        "descriptor": "name",
        "attributes": [
            {
                "name": "name",
                "type": "string",
                "options": {
                    "unique": true
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 1
                    },
                    "csv": {
                        "visible": true,
                        "order": 1
                    }
                }
            },
            {
                "name": "parent",
                "type": "belongs_to",
                "options": {
                    "type": "directory",
                    "inverse": {
                        "name": "sub_directories",
                        "type": "has_many"
                    }
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 2
                    },
                    "csv": {
                        "visible": true,
                        "order": 2
                    }
                }
            },
            {
                "name": "files",
                "type": "attachments",
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 3
                    },
                    "csv": {
                        "visible": true,
                        "order": 3
                    }
                }
            }
        ]
    },
    "client": {
        "descriptor": "full_name",
        "virtuals": [
            {
                "name": "full_name",
                "function": "$first_name $last_name",
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 1
                    },
                    "csv": {
                        "visible": true,
                        "order": 1
                    },
                    "pdf": {
                        "visible": true,
                        "order": 1
                    }
                }
            }
        ],
        "attributes": [
            {
                "name": "first_name",
                "type": "string",
                "options": {
                    "required": true
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 2
                    },
                    "csv": {
                        "visible": true,
                        "order": 2
                    },
                    "pdf": {
                        "visible": true,
                        "order": 2
                    }
                }
            },
            {
                "name": "last_name",
                "type": "string",
                "options": {
                    "required": true
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 3
                    },
                    "csv": {
                        "visible": true,
                        "order": 3
                    },
                    "pdf": {
                        "visible": true,
                        "order": 3
                    }
                }
            }
        ]
    },
    "sub_category": {
        "descriptor": "designation",
        "attributes": [
            {
                "name": "designation",
                "type": "string",
                "options": {
                    "unique": true
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 1
                    },
                    "csv": {
                        "visible": true,
                        "order": 1
                    },
                    "pdf": {
                        "visible": true,
                        "order": 1
                    }
                }
            },
            {
                "name": "category",
                "type": "belongs_to",
                "options": {
                    "required": true,
                    "inverse": {
                        "type": "has_many"
                    }
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 2
                    },
                    "csv": {
                        "visible": true,
                        "order": 2
                    },
                    "pdf": {
                        "visible": true,
                        "order": 2
                    }
                }
            }
        ]
    },
    "category": {
        "descriptor": "designation",
        "attributes": [
            {
                "name": "designation",
                "type": "string",
                "options": {
                    "unique": true,
                    "required": true
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 1
                    },
                    "csv": {
                        "visible": true,
                        "order": 1
                    },
                    "pdf": {
                        "visible": true,
                        "order": 1
                    }
                }
            }
        ]
    },
    "product": {
        "descriptor": "reference",
        "virtuals": [
            {
                "name": "tax_inclusive_price",
                "function": "$price * $vat",
                "renderer": {
                    "formatter": "$VAL €",
                    "json": {
                        "visible": true,
                        "order": 1
                    },
                    "csv": {
                        "visible": true,
                        "order": 1
                    },
                    "pdf": {
                        "visible": true,
                        "order": 1
                    }
                }
            },
            {
                "name": "reference",
                "function": "ref-$id-$sub_category.id",
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 2
                    },
                    "csv": {
                        "visible": true,
                        "order": 2
                    },
                    "pdf": {
                        "visible": true,
                        "order": 2
                    }
                }
            }
        ],
        "attributes": [
            {
                "name": "designation",
                "type": "string",
                "options": {
                    "unique": true,
                    "limit": 100
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 3
                    },
                    "csv": {
                        "visible": true,
                        "order": 3
                    },
                    "pdf": {
                        "visible": true,
                        "order": 3
                    }
                }
            },
            {
                "name": "description",
                "type": "string",
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 5
                    },
                    "csv": {
                        "visible": true,
                        "order": 5
                    },
                    "pdf": {
                        "visible": true,
                        "order": 5
                    }
                }
            },
            {
                "name": "price",
                "type": "decimal",
                "options": {
                    "precision": 5,
                    "scale": 2
                },
                "renderer": {
                    "formatter": "$VAL €",
                    "json": {
                        "visible": true,
                        "order": 4
                    },
                    "csv": {
                        "visible": true,
                        "order": 4
                    },
                    "pdf": {
                        "visible": true,
                        "order": 4
                    }
                }
            },
            {
                "name": "vat",
                "type": "float",
                "options": {
                    "default": 19.6
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 6
                    },
                    "csv": {
                        "visible": true,
                        "order": 6
                    },
                    "pdf": {
                        "visible": true,
                        "order": 6
                    }
                }
            },
            {
                "name": "in_stock",
                "type": "boolean",
                "options": {
                    "default": false
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 7
                    },
                    "csv": {
                        "visible": true,
                        "order": 7
                    },
                    "pdf": {
                        "visible": true,
                        "order": 7
                    }
                }
            },
            {
                "name": "logo",
                "type": "attachment",
                "renderer": {
                    "json": {
                        "visible": false
                    },
                    "csv": {
                        "visible": false
                    },
                    "pdf": {
                        "visible": true,
                        "order": 9
                    }
                }
            },
            {
                "name": "state",
                "type": "enum",
                "options": [
                    "available",
                    "not_available",
                    "available_soon"
                ],
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 10
                    },
                    "csv": {
                        "visible": true,
                        "order": 10
                    },
                    "pdf": {
                        "visible": true,
                        "order": 10
                    }
                }
            },
            {
                "name": "sub_category",
                "type": "belongs_to",
                "options": {
                    "required": true,
                    "inverse": {
                        "type": "has_many"
                    }
                },
                "renderer": {
                    "json": {
                        "visible": true,
                        "order": 8
                    },
                    "csv": {
                        "visible": true,
                        "order": 8
                    },
                    "pdf": {
                        "visible": true,
                        "order": 8
                    }
                }
            }
        ]
    }
}